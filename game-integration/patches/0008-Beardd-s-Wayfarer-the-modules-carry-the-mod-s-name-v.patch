From 248d2107544d8d478594f16008b4c573bf70e69e Mon Sep 17 00:00:00 2001
From: BearddOddity <beardedoddity@gmail.com>
Date: Wed, 14 Oct 2026 07:03:38 -0500
Subject: [PATCH 8/9] Beardd's Wayfarer: the modules carry the mod's name,
 version 1.1.0

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 modules/guide-trail/module.json |  8 ++++----
 modules/pins/module.json        | 14 +++++---------
 modules/waypoint/module.json    |  8 ++++----
 3 files changed, 13 insertions(+), 17 deletions(-)

diff --git a/modules/guide-trail/module.json b/modules/guide-trail/module.json
index ab50ccefae..398367ebca 100644
--- a/modules/guide-trail/module.json
+++ b/modules/guide-trail/module.json
@@ -1,9 +1,9 @@
 {
   "id": "guide-trail",
-  "name": "Guide trail",
-  "version": "1.0.0",
+  "name": "Beardd's Wayfarer: guide trail",
+  "version": "1.1.0",
   "api": 1,
-  "author": "BearddOddity",
-  "description": "Gold embers drift along the way to the place your compass marks: the tracked quest, or a destination or pin you set. F4 turns it on or off; Shift+F4 changes its look.",
+  "author": "Beardd (BearddOddity)",
+  "description": "Embers drift along the way to the place the compass marks: round walls, up hills and stairs, and between a dungeon's floors by the way your map knows. F4 on/off, Shift+F4 its look (the compass's mark takes the trail's colour).",
   "events": ["questMark", "drawFx"]
 }
diff --git a/modules/pins/module.json b/modules/pins/module.json
index c57b4b61c9..cf0e19177a 100644
--- a/modules/pins/module.json
+++ b/modules/pins/module.json
@@ -1,13 +1,9 @@
 {
   "id": "pins",
-  "name": "Pins",
-  "version": "1.0.0",
+  "name": "Beardd's Wayfarer: pins",
+  "version": "1.1.0",
   "api": 1,
-  "author": "BearddOddity",
-  "description": "Right-click the local map to set a destination or pick a quest location; F2 drops a pin where you look, F3 cycles quest and places, Shift+F2 removes one, Right-click a dungeon's exit on its map to be guided back out. The compass, waypoint and trail follow the place.",
-  "events": [
-    "mapPick",
-    "questMark",
-    "drawFx"
-  ]
+  "author": "Beardd (BearddOddity)",
+  "description": "Your own places to go: right-click the local map for a destination (or a quest's location, or a dungeon's exit), middle-click a dungeon map to pin and name a spot, Follow a region-map waypoint; F2 drops a pin where you look, F3 cycles the quest and your places, Shift+F2 removes one. The compass, waypoint and trail follow the place.",
+  "events": ["mapPick", "questMark", "drawFx"]
 }
diff --git a/modules/waypoint/module.json b/modules/waypoint/module.json
index 7c13df4a1c..07fa461712 100644
--- a/modules/waypoint/module.json
+++ b/modules/waypoint/module.json
@@ -1,9 +1,9 @@
 {
   "id": "waypoint",
-  "name": "Quest waypoint",
-  "version": "1.0.0",
+  "name": "Beardd's Wayfarer: quest waypoint",
+  "version": "1.1.0",
   "api": 1,
-  "author": "BearddOddity",
-  "description": "A gold diamond in the view over the place your compass marks for the tracked quest, with the distance, and an edge arrow when it is off to a side. F7 toggles it.",
+  "author": "Beardd (BearddOddity)",
+  "description": "A diamond in the view over the place the compass marks - the tracked quest, or a pin, destination, exit or region-map waypoint, each in its own colour and word - with the distance and the time at your pace, and an arrow at the screen's edge when it is off to a side. F7 on/off, Shift+F3 its look.",
   "events": ["questMark", "drawFx"]
 }
-- 
2.53.0.windows.1

