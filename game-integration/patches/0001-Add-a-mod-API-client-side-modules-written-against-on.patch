+test('MODS1: THE MODULES CARD - one row a module with what became of it and a switch; the switch is the player\'s and is kept; a tab says it needs the app', async () => {
+  const { modulesCard, moduleStateText } = await import('../src/ui/modulesCard.js');
+  const { modBus, setModuleReport } = await import('../src/mods/modBus.js');
+  const mem = new Map();
+  globalThis.localStorage = { getItem: (k) => mem.get(k) ?? null, setItem: (k, v) => mem.set(k, v), removeItem: (k) => mem.delete(k), key: () => null, length: 0 };
+  const el = (tag, cls = null, text = '') => { const n = { tag, cls, text, textContent: text, children: [], onclick: null, append(...c) { n.children.push(...c); } }; return n; };
+  const texts = (n) => [n.textContent, ...n.children.flatMap(texts)].filter(Boolean);
+  const buttons = (n) => (n.tag === 'button' ? [n] : n.children.flatMap(buttons));
+
+  assert.ok(texts(modulesCard(el, { hasShell: false })).includes('Modules need the desktop app.'));
+  setModuleReport([]);
+  assert.ok(texts(modulesCard(el, { hasShell: true })).includes('No modules are installed.'));
+
+  const bus = modBus;
+  const h = bus.register(parseManifest({ ...good, id: 'cardmod', name: 'Card module', author: 'someone' }).manifest);
+  let heard = 0; h.on('questMark', () => { heard++; });
+  setModuleReport([
+    { dir: 'cardmod', name: 'Card module', version: '1.2.0', state: 'running', reason: '' },
+    { dir: 'sleeper', name: 'Sleeper', version: '1.0.0', state: 'off', reason: 'switched off' },
+    { dir: 'future', name: 'Future', version: '2.0.0', state: 'refused', reason: 'needs interface 9; this game has 1' },
+  ]);
+  setModuleOff(globalThis.localStorage, 'sleeper', true);   // what a module reported 'off' at the start is in the player's record
+  const card = modulesCard(el, { hasShell: true });
+  const all = texts(card);
+  assert.ok(all.includes('Card module 1.2.0 - someone'), 'name, version and author');
+  assert.ok(all.includes('Running') && all.includes('Switched off') && all.includes('Not running: needs interface 9; this game has 1'), 'what became of each');
+  assert.deepEqual(buttons(card).map((b) => b.textContent), ['Turn off', 'Turn on'], 'a switch for the running one and the off one - none for a refused one');
+  bus.emit('questMark', null, null, 0); assert.equal(heard, 1);
+  buttons(card)[0].onclick();
+  assert.equal(buttons(card)[0].textContent, 'Turn on');
+  assert.deepEqual(modulesOff(globalThis.localStorage), ['cardmod', 'sleeper'], 'kept');
+  bus.emit('questMark', null, null, 0); assert.equal(heard, 1, 'a running module that is switched off hears nothing at once');
+  buttons(card)[0].onclick();
+  assert.deepEqual(modulesOff(globalThis.localStorage), ['sleeper']);
+  bus.emit('questMark', null, null, 0); assert.equal(heard, 2, 'and hears again when switched back on');
+  buttons(card)[1].onclick();   // the one that was off at the start: on at the next start, it was never imported
+  assert.ok(texts(card).includes('On at the next start'));
+  assert.deepEqual(modulesOff(globalThis.localStorage), [], 'the sleeper is now on in the record');
+  assert.equal(moduleStateText({ state: 'failed', reason: '' }), 'Not running');
+  delete globalThis.localStorage;
+});
