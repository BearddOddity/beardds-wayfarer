diff --git a/src/ui/modulesCard.js b/src/ui/modulesCard.js
new file mode 100644
index 0000000000..acf526b813
--- /dev/null
+++ b/src/ui/modulesCard.js
@@ -0,0 +1,63 @@
+// MODS1 (the mod API, src/mods/modApi.js): THE MODULES CARD - Settings > Mods & files > Modules: the modules the player has
+// installed in the desktop app's Mods folder, one row each with the name, version and author, what became of it at this start
+// (running, switched off, refused with its reason) and a switch.
+//
+// The switch is the player's: a module that is running is switched at once (the bus stops calling it); one that was off at the
+// start has never been imported, so turning it on takes effect at the next start - the row says so. A page with no desktop
+// shell has no Mods folder, and the card says that instead.
+//
+// Built with the pane's own element helper, so it draws as the pane's other cards do.
+import { appStorage } from '../systems/appStorage.js';
+import { t } from '../systems/textManager.js';
+import { modBus, moduleReport } from '../mods/modBus.js';
+import { modulesOff, setModuleOff } from '../mods/moduleHost.js';
+
+/** The row's words for what became of a module at this start. @param {{ state: string, reason: string }} r */
+export function moduleStateText(r) {
+  if (r.state === 'running') return t('menu.modules.running', 'Running');
+  if (r.state === 'off') return t('menu.modules.off', 'Switched off');
+  return r.reason ? `${t('menu.modules.refused', 'Not running')}: ${r.reason}` : t('menu.modules.refused', 'Not running');
+}
+
+/**
+ * @param {(tag: string, cls?: string|null, text?: string) => HTMLElement} el the pane's element helper
+ * @param {{ hasShell?: boolean }} [o]
+ */
+export function modulesCard(el, { hasShell = typeof globalThis.daggerShell?.modules?.list === 'function' } = {}) {
+  const c = el('div', 'card');
+  c.append(el('h3', null, t('menu.modules.title', 'Modules')));
+  c.append(el('div', 'meta', t('menu.modules.note', 'Client-side add-ons you installed in the app’s Mods folder. They only read what the game shows and draw on your own screen; nothing is sent to anyone.')));
+  if (!hasShell) { c.append(el('div', 'meta', t('menu.modules.noShell', 'Modules need the desktop app.'))); return c; }
+  const report = moduleReport();
+  if (!report.length) { c.append(el('div', 'meta', t('menu.modules.none', 'No modules are installed.'))); return c; }
+  const off = new Set(modulesOff(appStorage()));
+  for (const r of report) {
+    const row = el('div', 'row');
+    const main = el('div', 'row-main');
+    const info = modBus.modules().find((m) => m.id === r.dir);
+    main.append(el('div', 'row-name', `${r.name}${r.version ? ` ${r.version}` : ''}${info?.author ? ` - ${info.author}` : ''}`));
+    const state = el('div', 'meta', moduleStateText(r));
+    main.append(state);
+    row.append(main);
+    if (r.state === 'running' || r.state === 'off') {
+      const ctl = el('div', 'ctl');
+      const b = el('button', 'act rowact', off.has(r.dir) ? t('menu.modules.turnOn', 'Turn on') : t('menu.modules.turnOff', 'Turn off'));
+      b.onclick = () => {
+        const nowOff = !off.has(r.dir);
+        if (nowOff) off.add(r.dir); else off.delete(r.dir);
+        setModuleOff(appStorage(), r.dir, nowOff);
+        b.textContent = nowOff ? t('menu.modules.turnOn', 'Turn on') : t('menu.modules.turnOff', 'Turn off');
+        if (r.state === 'running') {
+          modBus.setEnabled(r.dir, !nowOff);
+          state.textContent = nowOff ? t('menu.modules.off', 'Switched off') : t('menu.modules.running', 'Running');
+        } else {
+          state.textContent = nowOff ? t('menu.modules.off', 'Switched off') : t('menu.modules.restart', 'On at the next start');
+        }
+      };
+      ctl.append(b);
+      row.append(ctl);
+    }
+    c.append(row);
+  }
+  return c;
+}
