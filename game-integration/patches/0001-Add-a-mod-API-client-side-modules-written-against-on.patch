+    if (src.includes('boom')) throw new Error('syntax');
+    if (src.includes('nodefault')) return {};
+    return { default: async (dfo) => { dfo.on('questMark', () => {}); } };
+  };
+  const bus = createModBus({ warn: quiet });
+  const m = (id, extra = {}) => ({ dir: id, manifest: { ...good, id, name: id.toUpperCase(), ...extra } });
+  const storage = { getItem: (k) => (k === MODULES_OFF_KEY ? JSON.stringify(['sleeper']) : null), setItem() {} };
+  const shell = fakeShell([
+    m('fine'), m('sleeper'), m('future', { api: 9 }), m('wrongdir'), { dir: 'broken', manifest: null, error: 'module.json: not found' },
+    { dir: 'junk', manifest: { id: 'junk', colour: 1 } }, m('boom'), m('nodefault'), m('bad-hash', { sha256: '0'.repeat(64) }), m('good-hash'),
+  ].map((e) => (e.dir === 'wrongdir' ? { ...e, manifest: { ...e.manifest, id: 'other' } } : e)), {
+    boom: { 'module.js': '// boom' }, nodefault: { 'module.js': '// nodefault' },
+  });
+  const report = await startModules({ shell, bus, storage, importModule, hash: async (t) => (t.includes('good-hash') ? '0'.repeat(64) : 'f'.repeat(64)), warn: quiet });
+  const by = Object.fromEntries(report.map((r) => [r.dir, [r.state, r.reason]]));
+  assert.deepEqual(by.fine, ['running', '']);
+  assert.deepEqual(by.sleeper, ['off', 'switched off']);
+  assert.match(by.future[1], /needs interface 9/); assert.equal(by.future[0], 'refused');
+  assert.match(by.wrongdir[1], /folder is 'wrongdir' but the manifest's id is 'other'/);
+  assert.deepEqual(by.broken, ['refused', 'module.json: not found']);
+  assert.match(by.junk[1], /unknown field 'colour'/);
+  assert.deepEqual([by.boom[0], by.boom[1]], ['failed', 'syntax']);
+  assert.match(by.nodefault[1], /no default export setup\(dfo\)/);
+  assert.deepEqual([by['bad-hash'][0], /sha256/.test(by['bad-hash'][1])], ['refused', true]);
+  assert.equal(by['good-hash'][0], 'running');
+  assert.ok(!imported.some((s) => s.startsWith('// sleeper')), 'a module that is off is never imported: none of its code runs');
+  assert.ok(!imported.some((s) => s.startsWith('// future')), 'nor one the interface refuses');
+  assert.deepEqual(bus.modules().map((x) => x.id).sort(), ['fine', 'good-hash'], 'only the running ones are on the bus');
+  assert.equal(bus.has('questMark'), true);
