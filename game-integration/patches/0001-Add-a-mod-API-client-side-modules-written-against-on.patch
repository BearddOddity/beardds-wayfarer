diff --git a/src/mods/modApi.js b/src/mods/modApi.js
new file mode 100644
index 0000000000..1d294d0636
--- /dev/null
+++ b/src/mods/modApi.js
@@ -0,0 +1,179 @@
+// @ts-check
+// MODS (2026-10-13, a player: the accessibility mod "needs to be a module like a rust crate type of mod ... unchained from
+// versioning ... it should work online"): THE MOD API - the small, stable surface a client-side module is written against.
+//
+// A MODULE IS A FOLDER, as a crate is: `module.json` (its manifest) and its code (`module.js`, one ES module whose default
+// export is `setup(dfo)`). The manifest names the module (`id`, `name`, its own `version`), the interface it was written for
+// (`api`, one whole number) and EVERY EVENT IT LISTENS TO (`events`) - that list is its whole contact with the game: the bus
+// hands it those events and no others, so a module's reach is read off its manifest.
+//
+// UNCHAINED FROM THE GAME'S VERSION. A module never names a game build. The interface is APPEND-ONLY: an event, once
+// shipped, keeps its name and its argument list forever, and a later version only ADDS events (and, at an event's end,
+// arguments); so a module written for api N runs on every game whose MOD_API_VERSION is N or more, untouched by the dozens
+// of releases a week. The game pins each event at its seam (test/mods1_api.test.js reads the source for the call), so the
+// hook cannot be dropped in a refactor without a test saying so.
+//
+// CLIENT-SIDE ONLY. A module is code the player installed, run in the player's own client: it reads what the game already
+// shows and draws on the player's own screen. The bus carries nothing to the server and changes no wire; a module has no
+// door to send a message to the relay, and a session online is exactly a session offline to everyone else in it.
+//
+// Not a DFU member. Ledger A (MODS1).
+
+/** The interface's version. A module's `api` is at most this; raised only when an event is ADDED, never when one changes. */
+export const MOD_API_VERSION = 1;
+
+/**
+ * THE EVENTS. Each: `since` (the api it arrived in), `args` (the argument list, in order - append-only), `doc`.
+ * @type {Readonly<Record<string, Readonly<{ since: number, args: ReadonlyArray<string>, doc: string }>>>}
+ */
+export const MOD_EVENTS = Object.freeze({
+  questMark: Object.freeze({
+    since: 1,
+    args: Object.freeze(['questXZ', 'playerXZ', 'heading01']),
+    doc: 'Every frame the HUD draws, in every scene: where the game\'s own compass marks the tracked quest ([x, z] in the scene\'s frame, null when it marks none), where the player stands ([x, z]) and which way they face (0..1 round the compass). The enhanced skin only.',
+  }),
+  quests: Object.freeze({
+    since: 1,
+    args: Object.freeze(['views']),
+    doc: 'After each quest tick: the game\'s own view of every active quest - { id, title, main, urgent, clockSeconds, words, latest: { lines }, target }.',
+  }),
+  drawFx: Object.freeze({
+    since: 1,
+    args: Object.freeze(['renderer']),
+    doc: 'Every frame the world pass draws its effects, under the renderer\'s own camera (renderer._camPos the eye, createParticleEffect / updateParticleEffect / drawWorldParticleEffects the door a module draws through).',
+  }),
+});
+
+const SLUG = /^[a-z0-9][a-z0-9-]{0,63}$/;
+const DOTTED = /^\d+(\.\d+){0,3}$/;
+const ENTRY = /^[\w.-]+\.js$/;
+const FIELDS = new Set(['id', 'name', 'version', 'api', 'author', 'description', 'events', 'entry', 'sha256']);
+
+/**
+ * Read a module's manifest. Unknown fields are refused (a typo is not a silent default), the entry is a plain file name in the
+ * module's own folder, and the events are all ones this interface knows. Pure.
+ * @param {unknown} raw the parsed module.json
+ * @returns {{ ok: boolean, manifest: Manifest|null, errors: string[] }}
+ * @typedef {{ id: string, name: string, version: string, api: number, author: string, description: string, events: string[], entry: string, sha256: string|null }} Manifest
+ */
+export function parseManifest(raw) {
+  /** @type {string[]} */ const errors = [];
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return { ok: false, manifest: null, errors: ['the manifest is not an object'] };
+  const m = /** @type {Record<string, any>} */ (raw);
+  for (const k of Object.keys(m)) if (!FIELDS.has(k)) errors.push(`unknown field '${k}'`);
+  if (typeof m.id !== 'string' || !SLUG.test(m.id)) errors.push('id: a lowercase slug (a-z, 0-9, -), up to 64');
+  if (typeof m.name !== 'string' || !m.name.trim()) errors.push('name: required');
+  if (typeof m.version !== 'string' || !DOTTED.test(m.version)) errors.push('version: dotted numbers, 1 to 4 parts (1.2.0) - the module\'s own, never the game\'s');
+  if (!Number.isInteger(m.api) || m.api < 1) errors.push('api: the interface version it was written for, a whole number from 1');
+  if (!Array.isArray(m.events) || !m.events.length) errors.push('events: the events it listens to (a module with none can see nothing)');
+  else {
+    for (const e of m.events) if (typeof e !== 'string' || !Object.hasOwn(MOD_EVENTS, e)) errors.push(`events: '${e}' is not an event of this interface`);
+    if (new Set(m.events).size !== m.events.length) errors.push('events: listed twice');
+  }
+  if (m.entry !== undefined && (typeof m.entry !== 'string' || !ENTRY.test(m.entry))) errors.push('entry: a .js file in the module\'s own folder');
+  if (m.sha256 !== undefined && (typeof m.sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(m.sha256))) errors.push('sha256: 64 hex digits of the entry file');
+  for (const k of ['author', 'description']) if (m[k] !== undefined && typeof m[k] !== 'string') errors.push(`${k}: a string`);
+  if (errors.length) return { ok: false, manifest: null, errors };
+  return {
+    ok: true,
+    errors,
+    manifest: {
+      id: m.id, name: m.name.trim(), version: m.version, api: m.api, author: m.author ?? '', description: m.description ?? '',
+      events: [...m.events], entry: m.entry ?? 'module.js', sha256: m.sha256 ?? null,
+    },
+  };
+}
+
+/**
+ * Does this game run a module written for `manifest.api`? The interface only grows, so any module whose api the game has
+ * reached runs; every event it names must have arrived by the api it declares (a module cannot reach past its own api).
+ * @param {Manifest} manifest @param {number} [gameApi]
+ * @returns {{ ok: boolean, reason: string }}
+ */
+export function moduleCompatible(manifest, gameApi = MOD_API_VERSION) {
+  if (manifest.api > gameApi) return { ok: false, reason: `needs interface ${manifest.api}; this game has ${gameApi}` };
+  for (const e of manifest.events) if (MOD_EVENTS[e].since > manifest.api) return { ok: false, reason: `'${e}' arrived in interface ${MOD_EVENTS[e].since}, after the ${manifest.api} the module declares` };
+  return { ok: true, reason: '' };
+}
+
+/** Failures one module may cause before the bus stops calling it for the session. */
+export const MOD_FAILURE_LIMIT = 25;
+
+/**
+ * THE BUS. The game emits (`emit`), each registered module listens through its own handle (`register`). Nothing here knows any
+ * module by name: a module hears the events its manifest lists, and only while it is enabled; a listener that throws is
+ * isolated - the frame and every other module go on - and a module that fails MOD_FAILURE_LIMIT times is switched off.
+ * @param {{ storage?: { getItem(k: string): string|null, setItem(k: string, v: string): void } | null,
+ *   say?: (text: string) => void, onKey?: (code: string, shift: boolean, fn: (e: any) => void) => void,
+ *   warn?: (...a: any[]) => void }} [deps]
+ */
+export function createModBus({ storage = null, say = () => {}, onKey = () => {}, warn = console.warn } = {}) {
+  /** @type {Map<string, Set<{ id: string, fn: (...a: any[]) => void }>>} */ const listeners = new Map();
+  /** @type {Map<string, { manifest: Manifest, enabled: boolean, failures: number, off: string|null }>} */ const mods = new Map();
+
+  return {
+    api: MOD_API_VERSION,
+
+    /** Is anything listening to `event` - the game's seams ask this first, so an event nobody wants costs a lookup. @param {string} event */
+    has: (event) => (listeners.get(event)?.size ?? 0) > 0,
+
+    /** The game's side: announce `event`. Each enabled listener on its own, a failing one counted. @param {string} event @param {...any} args */
+    emit(event, ...args) {
+      const set = listeners.get(event);
+      if (!set) return;
+      for (const l of set) {
+        const m = mods.get(l.id);
+        if (!m || !m.enabled) continue;
+        try { l.fn(...args); } catch (e) {
+          if (++m.failures === 1) warn(`[module ${l.id}] a listener on '${event}' failed:`, e);
+          if (m.failures >= MOD_FAILURE_LIMIT) { m.enabled = false; m.off = `failed ${MOD_FAILURE_LIMIT} times`; warn(`[module ${l.id}] switched off for the session`); }
+        }
+      }
+    },
+
+    /**
+     * A module's side: its handle. `dfo.on(event, fn)` works only for an event the manifest lists (others are refused, once,
+     * with a warning); `dfo.store` is the module's own settings, apart from every other's; `dfo.say` a line over the game;
+     * `dfo.onKey('F7', fn)` a key; `dfo.api` the interface version this game speaks.
+     * @param {Manifest} manifest
+     */
+    register(manifest) {
+      if (mods.has(manifest.id)) throw new Error(`module '${manifest.id}' is already registered`);
+      mods.set(manifest.id, { manifest, enabled: true, failures: 0, off: null });
+      const key = `dfjs-module-${manifest.id}`;
+      const read = () => { try { return JSON.parse(storage?.getItem(key) || '{}') || {}; } catch { return {}; } };
+      return Object.freeze({
+        api: MOD_API_VERSION,
+        id: manifest.id,
+        on(/** @type {string} */ event, /** @type {(...a: any[]) => void} */ fn) {
+          if (!manifest.events.includes(event)) { warn(`[module ${manifest.id}] '${event}' is not in its manifest's events - not delivered`); return () => {}; }
+          let set = listeners.get(event);
+          if (!set) listeners.set(event, set = new Set());
+          const l = { id: manifest.id, fn };
+          set.add(l);
+          return () => { set?.delete(l); };
+        },
+        store: Object.freeze({
+          get: (/** @type {string} */ k, /** @type {any} */ fallback) => { const v = read()[k]; return v === undefined ? fallback : v; },
+          set: (/** @type {string} */ k, /** @type {any} */ v) => { try { storage?.setItem(key, JSON.stringify({ ...read(), [k]: v })); } catch { /* not kept */ } },
+        }),
+        say: (/** @type {string} */ text) => { if (mods.get(manifest.id)?.enabled) say(String(text)); },
+        onKey: (/** @type {string} */ spec, /** @type {(e: any) => void} */ fn) => {
+          const parts = spec.split('+'), code = /** @type {string} */ (parts.pop());
+          onKey(code, parts.includes('Shift'), (e) => { if (mods.get(manifest.id)?.enabled) fn(e); });
+        },
+      });
+    },
+
+    /** Switch a registered module on or off (its listeners stay; the bus skips them while it is off). @param {string} id @param {boolean} on */
+    setEnabled(id, on) {
+      const m = mods.get(id);
+      if (!m) return false;
+      m.enabled = !!on; m.off = on ? null : 'switched off';
+      if (on) m.failures = 0;
+      return true;
+    },
+    /** The modules the bus knows: { id, name, version, enabled, off, failures }. */
+    modules: () => [...mods.values()].map((m) => ({ id: m.manifest.id, name: m.manifest.name, version: m.manifest.version, author: m.manifest.author, description: m.manifest.description, events: m.manifest.events, enabled: m.enabled, off: m.off, failures: m.failures })),
+  };
+}
