diff --git a/test/mods1_api.test.js b/test/mods1_api.test.js
new file mode 100644
index 0000000000..cc3901b55f
--- /dev/null
+++ b/test/mods1_api.test.js
@@ -0,0 +1,293 @@
+// MODS1 (2026-10-13, a player: the accessibility mod "needs to be a module like a rust crate type of mod ... unchained from
+// versioning ... it should work online") - THE MOD API (src/mods/modApi.js, moduleHost.js, modBus.js; app/lib/moduleFiles.cjs;
+// bible/06-Systems/Mod-API.md). Its laws:
+//
+//   A MODULE IS A FOLDER - a manifest that names it, the interface it was written for and every event it hears; unknown
+//     fields, a bad slug, a path for an entry, an event the interface has not: refused, each with its reason.
+//   UNCHAINED FROM THE GAME'S VERSION - the manifest names an interface number, never a game build; a module for interface N
+//     runs on every game that has N or more, and the event table is APPEND-ONLY (pinned here name by name, argument by argument).
+//   THE BUS HANDS A MODULE ITS EVENTS AND NO OTHERS - a failing listener is isolated, a module that keeps failing is switched
+//     off, a switched-off module hears nothing, a module's settings are its own.
+//   THE HOST - reads, judges and starts each module on its own: a bad one is a line in the report and the rest carry on; a
+//     module that is off is never imported; a module whose entry does not match its sha256 is not run.
+//   THE SHELL'S DOOR - the Mods folder read for the page: a plain folder slug, a plain .js name, nothing past them.
+//   THE SEAMS - the HUD, the shared magic engine and the quest bridge each announce their event on the one bus, so the hooks
+//     cannot be dropped in a refactor without this saying so; the page starts the modules off the entry's static graph.
+//   CLIENT-SIDE ONLY - the API reaches nothing of the net.
+import './modsOff.js';
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync, mkdtempSync, mkdirSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { createRequire } from 'node:module';
+import { MOD_API_VERSION, MOD_EVENTS, MOD_FAILURE_LIMIT, parseManifest, moduleCompatible, createModBus } from '../src/mods/modApi.js';
+import { startModules, modulesOff, setModuleOff, MODULES_OFF_KEY } from '../src/mods/moduleHost.js';
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
+const read = (p) => readFileSync(join(ROOT, p), 'utf8');
+const require = createRequire(import.meta.url);
+const { createModuleFiles } = require('../app/lib/moduleFiles.cjs');
+
+const good = { id: 'waypoint', name: 'Quest waypoint', version: '1.2.0', api: 1, events: ['questMark'] };
+const quiet = () => {};
+
+test('MODS1: A MANIFEST - read with its defaults, unknown fields and bad values refused with their reasons', () => {
+  const ok = parseManifest(good);
+  assert.equal(ok.ok, true);
+  assert.deepEqual(ok.manifest, { id: 'waypoint', name: 'Quest waypoint', version: '1.2.0', api: 1, author: '', description: '', events: ['questMark'], entry: 'module.js', sha256: null });
+  const bad = (patch, re) => { const r = parseManifest({ ...good, ...patch }); assert.equal(r.ok, false); assert.match(r.errors.join(';'), re, JSON.stringify(patch)); };
+  bad({ colour: 'gold' }, /unknown field 'colour'/);
+  bad({ id: 'Way Point' }, /id:/); bad({ id: '' }, /id:/); bad({ id: '../x' }, /id:/);
+  bad({ name: '  ' }, /name:/);
+  bad({ version: 'v1' }, /version:/); bad({ version: '1.2.3.4.5' }, /version:/);
+  bad({ api: 0 }, /api:/); bad({ api: 1.5 }, /api:/); bad({ api: '1' }, /api:/);
+  bad({ events: [] }, /events:/); bad({ events: ['nope'] }, /not an event/); bad({ events: ['questMark', 'questMark'] }, /twice/);
+  bad({ entry: '../module.js' }, /entry:/); bad({ entry: 'dir/module.js' }, /entry:/); bad({ entry: 'main.exe' }, /entry:/);
+  bad({ sha256: 'abc' }, /sha256:/);
+  assert.equal(parseManifest(null).ok, false);
+  assert.equal(parseManifest([]).ok, false);
+  assert.equal(parseManifest({ ...good, entry: 'mod.js', sha256: 'a'.repeat(64), author: 'me', description: 'd' }).ok, true);
+});
+
+test('MODS1: UNCHAINED FROM THE GAME - a module names an interface, never a build; one for interface N runs on N or more; it cannot reach past its own', () => {
+  const m = parseManifest(good).manifest;
+  assert.deepEqual(moduleCompatible(m, 1), { ok: true, reason: '' });
+  assert.deepEqual(moduleCompatible(m, 7), { ok: true, reason: '' }, 'a later game still runs it');
+  assert.equal(moduleCompatible({ ...m, api: 2 }, 1).ok, false);
+  assert.match(moduleCompatible({ ...m, api: 2 }, 1).reason, /needs interface 2; this game has 1/);
+  // an event cannot arrive after the interface a module declares it for: the one law a future table has to keep
+  assert.equal(moduleCompatible({ ...m, api: 1, events: ['questMark'] }, 1).ok, true);
+  assert.equal(MOD_EVENTS.questMark.since <= m.api, true, 'questMark is in interface 1');
+  assert.ok(MOD_API_VERSION >= 1 && Number.isInteger(MOD_API_VERSION));
+  assert.ok(Object.values(MOD_EVENTS).every((e) => e.since >= 1 && e.since <= MOD_API_VERSION), 'no event from an interface the game has not reached');
+  assert.equal(parseManifest(good).manifest.api, 1);
+  assert.ok(!('gameVersion' in parseManifest({ ...good }).manifest), 'no game build anywhere in a manifest');
+  assert.equal(parseManifest({ ...good, gameVersion: '0.1.8449' }).ok, false, 'and one that names a build is refused');
+});
+
+test('MODS1: THE EVENT TABLE IS APPEND-ONLY - every event, its interface and its arguments in order, pinned: a change here is a break for every module', () => {
+  assert.equal(MOD_API_VERSION, 1);
+  assert.deepEqual(Object.fromEntries(Object.entries(MOD_EVENTS).map(([k, e]) => [k, [e.since, [...e.args]]])), {
+    questMark: [1, ['questXZ', 'playerXZ', 'heading01']],
+    quests: [1, ['views']],
+    drawFx: [1, ['renderer']],
+  });
+  for (const e of Object.values(MOD_EVENTS)) assert.ok(e.doc.length > 40, 'each is documented');
+});
+
+test('MODS1: THE BUS - a module hears the events its manifest lists and no others; a failing listener is isolated; a module that keeps failing is switched off', () => {
+  const warned = [];
+  const bus = createModBus({ warn: (...a) => warned.push(a[0]) });
+  const a = bus.register(parseManifest({ ...good, id: 'a', events: ['questMark', 'quests'] }).manifest);
+  const b = bus.register(parseManifest({ ...good, id: 'b', events: ['questMark'] }).manifest);
+  const heard = [];
+  a.on('questMark', (...x) => heard.push(['a', ...x]));
+  a.on('quests', (x) => heard.push(['a-quests', x]));
+  b.on('questMark', () => { throw new Error('b fails'); });
+  b.on('quests', () => heard.push('b must not hear quests'));
+  assert.ok(warned.some((w) => /'quests' is not in its manifest/.test(w)), 'an unlisted event is refused, with a word');
+  assert.deepEqual([bus.has('questMark'), bus.has('quests'), bus.has('drawFx')], [true, true, false]);
+  bus.emit('questMark', [1, 2], [3, 4], 0.5);
+  bus.emit('quests', [{ id: 1 }]);
+  bus.emit('drawFx', {});
+  assert.deepEqual(heard, [['a', [1, 2], [3, 4], 0.5], ['a-quests', [{ id: 1 }]]], 'the failing listener did not stop the other module');
+  for (let i = 0; i < MOD_FAILURE_LIMIT + 3; i++) bus.emit('questMark', null, null, 0);
+  const row = (id) => bus.modules().find((m) => m.id === id);
+  assert.deepEqual([row('a').enabled, row('b').enabled, row('b').off], [true, false, `failed ${MOD_FAILURE_LIMIT} times`], 'b is off, a is not');
+  assert.equal(row('b').failures, MOD_FAILURE_LIMIT);
+  assert.equal(warned.filter((w) => /\[module b\] a listener on 'questMark' failed/.test(w)).length, 1, 'a failing listener is named once, not every frame');
+  assert.equal(warned.filter((w) => /\[module b\] switched off for the session/.test(w)).length, 1, 'and the switching off once')
+  const n = heard.length;
+  bus.setEnabled('a', false);
+  bus.emit('questMark', null, null, 0);
+  assert.equal(heard.length, n, 'a switched-off module hears nothing');
+  bus.setEnabled('a', true);
+  bus.emit('questMark', null, null, 0);
