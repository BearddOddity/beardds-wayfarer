diff --git a/scripts/buildModules.mjs b/scripts/buildModules.mjs
new file mode 100644
index 0000000000..a3028dc4a1
--- /dev/null
+++ b/scripts/buildModules.mjs
@@ -0,0 +1,45 @@
+// Builds the bundled modules (modules/<id>/): a module is a folder, its entry ONE ES module whose default export is
+// `setup(dfo)` - the page imports it from a blob, so it cannot `import` a sibling file at run time. A module written as
+// several files keeps them in `src/` and is bundled into its `module.js` here; a module written as one file needs nothing.
+//
+// Each module folder is also what `--install` copies into the desktop app's Mods folder (<user data>/Mods/<id>/), with the
+// entry's SHA-256 written into the installed manifest so the host can check it.
+//
+//   node scripts/buildModules.mjs                build every module that has a src/setup.js
+//   node scripts/buildModules.mjs --install <dir>   ...and copy every module into <dir>/Mods, the desktop app's user data folder
+//                                                 (the folder the app keeps its Saves in; DAGGER_USER_DATA's, if you set one)
+import { build } from 'esbuild';
+import { createHash } from 'node:crypto';
+import { cpSync, existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync, statSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const modulesDir = join(root, 'modules');
+const ids = readdirSync(modulesDir).filter((d) => statSync(join(modulesDir, d)).isDirectory() && existsSync(join(modulesDir, d, 'module.json')));
+
+for (const id of ids) {
+  const entry = join(modulesDir, id, 'src', 'setup.js');
+  if (!existsSync(entry)) continue;
+  await build({
+    entryPoints: [entry], outfile: join(modulesDir, id, 'module.js'),
+    bundle: true, format: 'esm', platform: 'browser', target: 'es2020', minify: false, logLevel: 'warning',
+    banner: { js: `// GENERATED by scripts/buildModules.mjs from modules/${id}/src - do not edit.` },
+  });
+  console.log(`built modules/${id}/module.js`);
+}
+
+const at = process.argv.indexOf('--install');
+if (at >= 0) {
+  const userData = process.argv[at + 1] ?? process.env.DAGGER_USER_DATA;
+  if (!userData) throw new Error('--install needs the app\'s user data folder: --install <dir>, or set DAGGER_USER_DATA');
+  for (const id of ids) {
+    const dest = join(userData, 'Mods', id);
+    mkdirSync(dest, { recursive: true });
+    cpSync(join(modulesDir, id), dest, { recursive: true, filter: (p) => !/[\\/]src([\\/]|$)/.test(p) });
+    const manifest = JSON.parse(readFileSync(join(dest, 'module.json'), 'utf8'));
+    manifest.sha256 = createHash('sha256').update(readFileSync(join(dest, manifest.entry ?? 'module.js'), 'utf8')).digest('hex');
+    writeFileSync(join(dest, 'module.json'), `${JSON.stringify(manifest, null, 2)}\n`);
+    console.log(`installed ${id} -> ${dest}`);
+  }
+}
