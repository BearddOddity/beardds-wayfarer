From f1448670265b3daf74fe4d7517d24733710af4b0 Mon Sep 17 00:00:00 2001
From: BearddOddity <beardedoddity@gmail.com>
Date: Wed, 14 Oct 2026 07:38:13 -0500
Subject: [PATCH 12/13] Keys panel: left centre - docked at the left edge,
 halfway down (the player: "it should be left center")

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/mods/keysPanel.js  | 6 +++---
 test/mods1_api.test.js | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/mods/keysPanel.js b/src/mods/keysPanel.js
index b192fc3f81..b21815b954 100644
--- a/src/mods/keysPanel.js
+++ b/src/mods/keysPanel.js
@@ -9,7 +9,7 @@
 // own storage) and takes effect at once.
 //
 // SMALL AND TO THE SIDE (the player: "way too big and in the way ... it shouldn't be center of the screen in case an enemy
-// appears"): docked at the left edge, under the compass's height, in small type, the middle of the view left clear. The
+// appears"; "it should be left center"): docked at the left edge, halfway down, in small type, the middle of the view left clear. The
 // actions are grouped by module, and a name every module shares ("Beardd's Wayfarer: ...") is said once, not on every row.
 //
 // While the panel is open it takes every key press: the game and the modules hear none, and the pointer is released so the
@@ -68,8 +68,8 @@ export function openKeysPanel(bus, { words }) {
   box.setAttribute('role', 'dialog');
   box.setAttribute('aria-modal', 'true');
   box.setAttribute('aria-label', w.title());
-  // docked at the left edge, below the compass's height: the middle of the view stays clear
-  box.style.cssText = 'position:fixed;left:12px;top:64px;z-index:2147483001;width:300px;max-width:calc(100vw - 24px);'
+  // docked at the left edge, halfway down: the middle of the view stays clear
+  box.style.cssText = 'position:fixed;left:12px;top:50%;transform:translateY(-50%);z-index:2147483001;width:300px;max-width:calc(100vw - 24px);'
     + 'max-height:calc(100vh - 180px);overflow:auto;padding:8px 10px;font:13px/1.3 "Pixelify Sans",Georgia,serif;color:#f2e6c4;'
     + 'background:rgba(10,12,17,0.86);border:1px solid #c9962c;box-shadow:0 0 10px #000';
   const title = document.createElement('h2');
diff --git a/test/mods1_api.test.js b/test/mods1_api.test.js
index 651d5b25b8..2f6223454b 100644
--- a/test/mods1_api.test.js
+++ b/test/mods1_api.test.js
@@ -210,7 +210,7 @@ test('MODS1: THE KEYS PANEL - small, at the left edge, the shared name once and
   assert.ok(![...actions.matchAll(/\['([A-Za-z0-9]+)', '[A-Za-z0-9]+'\]/g)].some((m) => m[1] === 'F1'), 'F1 is no gameplay default, so Shift+F1 is free');
   const panel = read('src/mods/keysPanel.js');
   assert.ok(panel.includes('spec === KEYS_PANEL_KEY || RESERVED.test(spec)'), 'the panel refuses its own key and the menus\' keys');
-  assert.ok(panel.includes("position:fixed;left:12px;top:64px;") && !panel.includes('translate(-50%,-50%)'), 'docked at the left edge, never over the middle of the view');
+  assert.ok(panel.includes("position:fixed;left:12px;top:50%;transform:translateY(-50%);") && !panel.includes('translate(-50%,-50%)'), 'docked at the left edge, halfway down - never over the middle of the view');
   assert.ok(panel.includes('bus.holdKeys(true)') && panel.includes('bus.holdKeys(false)') && panel.includes('exitPointerLock'), 'it holds the keys while open, and frees the pointer');
   assert.ok(read('src/mods/modBus.js').includes('installModuleKeys(modBus, { words: moduleKeyWords })'), 'the game\'s bus hands it every key press');
   assert.ok(read('src/ui/modulesCard.js').includes('openKeysPanel(modBus'), 'and the Modules card opens it');
