index 0000000000..815a625b7d
--- /dev/null
+++ b/modules/pins/module.js
@@ -0,0 +1,77 @@
+// MODULE: PINS - your own places to go.
+//
+// F2 drops a pin where the crosshair meets the world (or 25 m ahead over open ground), F3 cycles what the game's compass marks:
+// the tracked quest, then each pin in turn, then the quest again; Shift+F2 removes the pin you are following. The compass, the
+// quest waypoint and the guide trail all follow the compass's mark, so they follow the pin with no more than this - the module asks
+// the game to mark the place (`dfo.retarget`) and talks to no other module. Reaching a pin (3 m) removes it and goes on to the
+// next, or back to the quest. Pins belong to the place they were dropped in: a jump of 150 m (a door, a dungeon, a travel, a load)
+// clears them, since every place has its own frame. Hears `questMark` (the HUD's heartbeat, the player's spot) and `drawFx`
+// (the camera and the world to aim at); reaches nothing else.
+//
+// Keys, only while the game's HUD is up (never in a menu, a dialog or a map, where F2 and F3 mean other things).
+const HUD_LIVE_MS = 400;
+const MAX_PINS = 8;
+const AHEAD_M = 25;       // the pin goes this far ahead when the crosshair meets nothing
+const REACH_M = 3;
+const NEW_PLACE_M = 150;
+
+export default function setup(dfo) {
+  /** @type {number[][]} */ let pins = [];
+  let active = -1;            // the pin being followed, or -1: the game's own quest
+  let hudSeen = -1e9, player = null;   // where the player stands, from the HUD's mark
+  let eye = null, aim = null, world = null;
+  const playing = () => performance.now() - hudSeen < HUD_LIVE_MS;
+
+  const follow = (i) => {
+    active = i;
+    dfo.retarget(i >= 0 ? pins[i] : null);
+  };
+  const label = (i) => (i < 0 ? 'the quest' : `pin ${i + 1}`);
+
+  dfo.on('questMark', (_q, p) => {
+    hudSeen = performance.now();
+    player = p ? [p[0], p[1]] : null;
+    if (active >= 0 && player && Math.hypot(pins[active][0] - player[0], pins[active][1] - player[1]) < REACH_M) {
+      dfo.say(`Reached ${label(active)}`);
+      pins.splice(active, 1);
+      follow(pins.length ? Math.min(active, pins.length - 1) : -1);
+    }
+  });
+
+  dfo.on('drawFx', (renderer, probe) => {
+    const e = renderer?._camPos, v = renderer?._view;
+    if (!e || !v) return;
+    if (eye && Math.hypot(e[0] - eye[0], e[2] - eye[2]) > NEW_PLACE_M) { pins = []; follow(-1); }   // a new place: its own frame
+    eye = [e[0], e[1], e[2]];
+    aim = [-v[2], -v[6], -v[10]];   // the camera's forward, from the view matrix's third column's rows
+    world = probe ?? null;
+  });
+
+  function drop() {
+    if (!eye || !aim) { dfo.say('No pin: the view is not up'); return; }
+    if (pins.length >= MAX_PINS) { dfo.say(`No pin: ${MAX_PINS} already - remove one (Shift+F2)`); return; }
+    const flat = Math.hypot(aim[0], aim[2]) || 1;
+    let d = AHEAD_M / flat * 1;   // 25 m along the ground at any pitch
+    const hit = world?.ray?.(eye, aim, 120);
+    if (hit !== null && hit !== undefined) d = Math.max(0.5, hit - 0.3);
+    const x = eye[0] + aim[0] * d, z = eye[2] + aim[2] * d;
+    pins.push([x, z]);
+    follow(pins.length - 1);
+    dfo.say(`Pin ${pins.length} dropped - following it`);
+  }
+
+  dfo.onKey('F2', () => { if (playing()) drop(); });
+  dfo.onKey('Shift+F2', () => {
+    if (!playing()) return;
+    if (active < 0) { dfo.say('No pin followed'); return; }
+    pins.splice(active, 1);
+    dfo.say('Pin removed');
+    follow(pins.length ? Math.min(active, pins.length - 1) : -1);
+  });
+  dfo.onKey('F3', () => {
+    if (!playing()) return;
+    if (!pins.length) { dfo.say('No pins - F2 drops one'); return; }
+    follow(active + 1 >= pins.length ? -1 : active + 1);
+    dfo.say(`Following ${label(active)}`);
+  });
+}
