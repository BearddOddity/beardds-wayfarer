+test('MODS1: THE LOOKS AND THE LABEL - every look fills the ember field in its own colour and size; the waypoint says the time at the player\'s pace only when they move', async () => {
+  const { createEmberField, GUIDE_STYLES, GUIDE_STYLE_ORDER } = await import('../modules/guide-trail/src/embers.js');
+  const { distLabel, WAYPOINT_LOOKS } = await import('../modules/waypoint/module.js');
+  const path = [[0, 0, 0], [0, 0, 20]];
+  const sizes = {};
+  for (const name of GUIDE_STYLE_ORDER) {
+    const f = createEmberField(); const n = f.fill(path, 3, { style: GUIDE_STYLES[name] });
+    assert.ok(n > 10, `${name} draws`);
+    sizes[name] = Math.max(...f.embers.slice(0, n).map((e) => e.size));
+    assert.ok(f.embers.slice(0, n).every((e) => e.color.every((c) => c >= 0 && c <= 1) && e.alpha <= 1), `${name} stays a colour`);
+  }
+  assert.ok(sizes.large > sizes.gold * 1.5, 'the large look is large');
+  assert.notDeepEqual(GUIDE_STYLES.cyan.ember, GUIDE_STYLES.gold.ember);
+  assert.equal(distLabel(420, 0), '420 m', 'standing: the distance alone');
+  assert.equal(distLabel(420, 4), '420 m - 2 min', 'walking: the time too');
+  assert.equal(distLabel(40, 4), '40 m - 10 s');
+  assert.equal(distLabel(5, 4), '5 m', 'near: no time');
+  assert.equal(distLabel(1500, 3), '1.5 km - 8 min');
+  assert.ok(Object.keys(WAYPOINT_LOOKS).includes('large') && WAYPOINT_LOOKS.large.big);
+});
