+test('MODS1: NO CLASH WITH THE GAME - no module key is a default gameplay binding, no two modules share a key, every key handler is gated on the HUD being up', () => {
+  const actions = read('src/systems/inputActions.js');
+  const taken = new Set([...actions.matchAll(/\['([A-Za-z0-9]+)', '[A-Za-z0-9]+'\]/g)].map((m) => m[1]));
+  assert.ok(taken.has('F5') && taken.has('KeyM'), 'the game\'s default bindings were read');
+  const seen = new Map();
+  for (const id of ['waypoint', 'quest-tracker', 'guide-trail', 'pins']) {
+    const src = id === 'guide-trail' ? read('modules/guide-trail/src/setup.js') : read(`modules/${id}/module.js`);
+    const lines = src.split('\n').filter((l) => /dfo\.onKey\(/.test(l));
+    assert.ok(lines.length >= 1, `${id} has a key`);
+    for (const m of src.matchAll(/dfo\.onKey\('((?:Shift\+)?)([A-Za-z0-9]+)'/g)) {
+      assert.ok(!(m[1] === '' && taken.has(m[2])), `${id}: ${m[2]} is a gameplay binding of the game`);
+      const spec = m[1] + m[2];
+      assert.ok(!seen.has(spec), `${id} and ${seen.get(spec)} both bind ${spec}`);
+      seen.set(spec, id);
+    }
+    const handlers = src.split(/dfo\.onKey\(/).slice(1).map((s) => s.slice(0, 220));
+    assert.ok(handlers.every((s) => /playing\(\)|hudSeen/.test(s)), `${id}: a key works in a menu`);
+  }
+  assert.ok(seen.size >= 7, 'every module key is accounted for');
+});
