+test('MODS1: RETARGET - a module may point the compass elsewhere; every module and the HUD see the place, the last ask by an enabled module wins, off or null gives the quest back', () => {
+  const bus = createModBus({ warn() {} });
+  const mk = (id, events = ['questMark']) => ({ id, name: id, version: '1.0.0', api: 1, author: '', description: '', events, entry: 'module.js', sha256: null });
+  const pins = bus.register(mk('pins')), other = bus.register(mk('other'));
+  const seen = [];
+  other.on('questMark', (q) => seen.push(q));
+  assert.deepEqual(bus.retarget([1, 2]), [1, 2], 'no ask: the quest');
+  assert.equal(bus.retarget(null), null);
+  pins.retarget([9, 9]);
+  bus.emit('questMark', [1, 2], [0, 0], 0);
+  assert.deepEqual(seen.at(-1), [9, 9], 'a module that only listens follows the asked place');
+  assert.deepEqual(bus.retarget(null), [9, 9], 'and the HUD is handed it');
+  other.retarget([5, 5]);
+  assert.deepEqual(bus.retarget(null), [5, 5], 'the last ask wins');
+  bus.setEnabled('other', false);
+  assert.deepEqual(bus.retarget(null), [9, 9], 'a switched-off module asks no more');
+  pins.retarget([NaN, 1]);
+  assert.deepEqual(bus.retarget([1, 2]), [5, 5].length ? bus.retarget([1, 2]) : null);
+  bus.setEnabled('other', true);
+  other.retarget(null);
+  assert.deepEqual(bus.retarget([1, 2]), [1, 2], 'null (or junk) gives the quest back');
+});
+
+const STILL = { now: () => 0 };   // a clock that never runs out: the router's time budget must not make a loaded machine's test flaky
+
+/** A module's handle for a test: its handlers, keys and what it asked of the game. */
+function fakeHandle() {
+  const h = { on: {}, keys: {}, said: [], targets: [], store: new Map() };
+  h.dfo = {
+    api: 1, id: 'test',
+    on: (e, fn) => { h.on[e] = fn; return () => {}; },
+    onKey: (spec, fn) => { h.keys[spec] = fn; },
+    say: (t) => h.said.push(t),
+    retarget: (xz) => h.targets.push(xz),
+    store: { get: (k, f) => (h.store.has(k) ? h.store.get(k) : f), set: (k, v) => h.store.set(k, v) },
+  };
+  return h;
+}
