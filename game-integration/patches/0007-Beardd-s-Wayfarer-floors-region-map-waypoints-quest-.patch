+// @ts-check
+// MODS1 (the player: "i want the hotkeys to be custom to the user"): THE MODULE KEYS PANEL - every action a module put on a
+// key, with the key it has now, and a way to give it another.
+//
+// Opened with Shift+F1 wherever the game is (no gameplay action of the game's is on it), or from Settings > Mods & files >
+// Modules. Choose an action (click it, or Tab to it and press Enter), then press the new key: Escape cancels, Backspace puts
+// the module's own key back. A key another module action has is refused with its name. A plain letter, digit, arrow or Space
+// is allowed with a warning, since the game may use it too. The choice is the bus's (createModBus setKey: kept in the game's
+// own storage) and takes effect at once.
+//
+// While the panel is open it takes every key press: the game and the modules hear none, and the pointer is released so the
+// panel can be clicked. Plain DOM and the words handed in (`words`), no game imports - so the loader's host (DFO Mods core) builds
+// the same panel for the released game.
+//
+// Not a DFU member. Ledger A (MODS1).
+
+import { keySpec } from './modApi.js';
+
+/** The key that opens the panel. Never a module's: the panel refuses it. */
+export const KEYS_PANEL_KEY = 'Shift+F1';
+/** Keys the panel itself and the game's menus use: never given to a module action. */
+const RESERVED = /^(Shift\+)?(Escape|Tab|Enter|Backspace|NumpadEnter)$/;
+/** Keys the game may well have on a plain press (movement, letters, numbers): allowed, with a warning. */
+const GAME_LIKELY = /^(Key[A-Z]|Digit\d|Arrow\w+|Space)$/;
+
+/** A key spec for people: 'Shift+KeyK' is 'Shift+K', 'Digit1' is '1'. Pure. @param {string|null} spec */
+export function keyName(spec) {
+  return spec ? spec.replace(/\b(Key|Digit)(?=\w$)/, '') : '';
+}
+
+/** @typedef {ReturnType<typeof import('./modApi.js').createModBus>} ModBus */
+/**
+ * THE PANEL'S WORDS, handed in by the host: the game's through its text core (modBus.js moduleKeyWords), the loader's in English.
+ * @typedef {{ title(): string, help(): string, done(): string, none(): string, press(): string, key(): string,
+ *   pressFor(what: string): string, reserved(key: string): string, taken(name: string, label: string): string, refused(): string,
+ *   gameKey(): string }} Words
+ */
+
+let open = null;
+
+/** Open the panel over the game (once; a second ask while it is open does nothing). @param {ModBus} bus @param {{ words: Words }} o */
+export function openKeysPanel(bus, { words }) {
+  const w = words;
+  if (open || typeof document === 'undefined' || !document.body) return;
+  document.exitPointerLock?.();
+  bus.holdKeys(true);
+
+  const box = document.createElement('div');
+  box.setAttribute('role', 'dialog');
+  box.setAttribute('aria-modal', 'true');
+  box.setAttribute('aria-label', w.title());
+  box.style.cssText = 'position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:2147483001;min-width:420px;max-width:90vw;'
+    + 'max-height:85vh;overflow:auto;padding:16px 20px;font:18px/1.4 "Pixelify Sans",Georgia,serif;color:#f2e6c4;'
+    + 'background:rgba(10,12,17,0.94);border:2px solid #c9962c;box-shadow:0 0 24px #000';
+  const title = document.createElement('h2');
+  title.textContent = w.title();
+  title.style.cssText = 'margin:0 0 6px;font-size:22px;color:#c9962c';
+  const help = document.createElement('p');
+  help.textContent = w.help();
+  help.style.cssText = 'margin:0 0 12px';
+  const list = document.createElement('div');
+  const status = document.createElement('p');
+  status.setAttribute('aria-live', 'polite');
+  status.style.cssText = 'min-height:1.4em;margin:12px 0;color:#f2cf4a';
+  const done = document.createElement('button');
+  done.textContent = w.done();
+  box.append(title, help, list, status, done);
+
+  const buttonStyle = 'font:inherit;color:inherit;background:#1d2230;border:1px solid #c9962c;padding:4px 12px;cursor:pointer;min-width:110px';
+  done.style.cssText = buttonStyle;
+  /** @type {{ id: string, key: string, label: string } | null} */ let waiting = null;
+
+  function render(focusKey = null) {
