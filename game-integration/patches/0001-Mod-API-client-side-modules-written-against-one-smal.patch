+// @ts-check
+// MODS1 (the mod API, src/mods/modApi.js): THE MODULE HOST - finds the modules the player has installed, checks each against
+// the interface, and runs the ones that are on.
+//
+// WHERE MODULES LIVE. The desktop app's Mods folder, `<user data>/Mods/<id>/` - the folder IS the module (`module.json`, its
+// entry `module.js`, anything else it ships). The app's preload reads that folder and hands this host the raw manifests and the
+// entry's source (`daggerShell.modules`: list, source); nothing else of the player's disk is reachable through it, and a
+// page with no shell (the website) has no modules.
+//
+// WHAT HAPPENS TO ONE. Its manifest is read (parseManifest: unknown fields refused), the folder's name must be the module's
+// id, the interface it was written for must be one this game has (moduleCompatible), the entry's SHA-256 must match the
+// manifest's where it names one - and then, only if the player has it on, its source is imported and `setup(dfo)` is run with
+// ITS OWN handle (the bus gives it the events its manifest lists, and no others). A module that is off is never imported: none
+// of its code runs. Whatever goes wrong with one - a bad manifest, a refused version, a source that throws - is a line in the
+// report beside its name, and the others carry on.
+//
+// A MODULE IS THE PLAYER'S CODE, run in the player's own client with the page's own reach: it is as trusted as anything the
+// player chose to install. What the bus promises is the SHAPE of its contact with the game, not a sandbox.
+//
+// Not a DFU member. Ledger A (MODS1).
+
+import { parseManifest, moduleCompatible } from './modApi.js';
+
+/** The key the player's switches are kept under (the ids of the modules turned OFF). */
+export const MODULES_OFF_KEY = 'dfjs-modules-off';
+
+/** Which modules the player turned off. @param {{ getItem(k: string): string|null }|null|undefined} storage @returns {string[]} */
+export function modulesOff(storage) {
+  try { const v = JSON.parse(storage?.getItem(MODULES_OFF_KEY) || '[]'); return Array.isArray(v) ? v.filter((x) => typeof x === 'string') : []; } catch { return []; }
+}
+/** Turn one on or off, kept. @param {{ getItem(k: string): string|null, setItem(k: string, v: string): void }|null|undefined} storage @param {string} id @param {boolean} off */
+export function setModuleOff(storage, id, off) {
+  const next = new Set(modulesOff(storage));
+  if (off) next.add(id); else next.delete(id);
+  try { storage?.setItem(MODULES_OFF_KEY, JSON.stringify([...next].sort())); } catch { /* not kept */ }
+}
+
+/** Import an ES module from its source text (a blob URL, revoked once it has loaded). @param {string} source */
+export async function importFromSource(source) {
+  const url = URL.createObjectURL(new Blob([source], { type: 'text/javascript' }));
+  try { return await import(/* @vite-ignore */ url); } finally { URL.revokeObjectURL(url); }
+}
+
+/** SHA-256 of a string, as hex. @param {string} text */
+export async function sha256Hex(text) {
+  const d = await globalThis.crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
+  return [...new Uint8Array(d)].map((b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+/**
+ * @typedef {{ dir: string, name: string, version: string, state: 'running'|'off'|'refused'|'failed', reason: string }} ModuleReport
+ */
+/**
+ * Start the installed modules.
+ * @param {{
+ *   shell: { modules?: { list(): Array<{ dir: string, manifest: unknown, error?: string }>, source(dir: string, file: string): string|null } } | null | undefined,
+ *   bus: ReturnType<typeof import('./modApi.js').createModBus>,
+ *   storage?: { getItem(k: string): string|null } | null,
+ *   importModule?: (source: string) => Promise<any>,
+ *   hash?: (text: string) => Promise<string>,
+ *   warn?: (...a: any[]) => void,
+ * }} o
+ * @returns {Promise<ModuleReport[]>}
+ */
+export async function startModules({ shell, bus, storage = null, importModule = importFromSource, hash = sha256Hex, warn = console.warn }) {
+  /** @type {ModuleReport[]} */ const report = [];
+  const found = shell?.modules?.list?.() ?? [];
+  const off = new Set(modulesOff(storage));
+  const seen = new Set();
+  for (const f of found) {
+    const row = { dir: f.dir, name: f.dir, version: '', state: /** @type {ModuleReport['state']} */ ('refused'), reason: '' };
+    report.push(row);
+    if (f.error) { row.reason = f.error; continue; }
+    const p = parseManifest(f.manifest);
+    if (!p.ok) { row.reason = p.errors.join('; '); continue; }
+    const m = /** @type {import('./modApi.js').Manifest} */ (p.manifest);
+    row.name = m.name; row.version = m.version;
+    if (m.id !== f.dir) { row.reason = `the folder is '${f.dir}' but the manifest's id is '${m.id}'`; continue; }
+    if (seen.has(m.id)) { row.reason = 'a second module with this id'; continue; }
+    seen.add(m.id);
+    const ok = moduleCompatible(m);
+    if (!ok.ok) { row.reason = ok.reason; continue; }
+    if (off.has(m.id)) { row.state = 'off'; row.reason = 'switched off'; continue; }
+    try {
+      const source = shell?.modules?.source(f.dir, m.entry);
+      if (typeof source !== 'string') { row.reason = `${m.entry} could not be read`; continue; }
+      if (m.sha256 && (await hash(source)) !== m.sha256) { row.reason = `${m.entry} does not match the manifest's sha256`; continue; }
+      const mod = await importModule(source);
+      if (typeof mod?.default !== 'function') { row.state = 'failed'; row.reason = `${m.entry} has no default export setup(dfo)`; continue; }
+      await mod.default(bus.register(m));
+      row.state = 'running'; row.reason = '';
+    } catch (e) {
+      row.state = 'failed'; row.reason = String(/** @type {any} */ (e)?.message ?? e);
+      warn(`[module ${m.id}] would not start:`, e);
+    }
+  }
+  return report;
+}
