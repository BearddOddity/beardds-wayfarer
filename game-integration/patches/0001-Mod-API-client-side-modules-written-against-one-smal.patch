+  assert.equal(groupKeys([R('a', "Beardd's Wayfarer: pins", '1')]).family, '', 'one module alone keeps its whole name');
+  assert.deepEqual(['Shift+KeyK', 'Digit1', 'F7', 'Numpad1', null].map(keyName), ['Shift+K', '1', 'F7', 'Numpad1', '']);
