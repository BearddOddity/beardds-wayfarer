+test('MODS1: THE SHEETS TAKE THE CLICK - the street plan and the dungeon plan answer a paper point as metres east and north of the player, stand a flag, and know it again; the window says it on the bus', async () => {
+  const { createTownSheet } = await import('../src/ui/townSheet.js');
+  const { WORLD_PER_PX } = await import('../src/ui/nameplateLayout.js');
+  const { RMB_DIMENSION } = await import('../src/formats/blocksFile.js');
+  const stub = () => new Proxy(function stubbed() {}, { get: (t, k) => (k === 'measureText' ? () => ({ width: 10 }) : stub()), apply: () => stub(), set: () => true });
+  const div = RMB_DIMENSION * 0.025;
+  const feet = [1 * div + 10, 0, 0 * div + div / 2];
+  const sheet = createTownSheet({ gridW: 2, gridH: 2, blocks: [{ x: 1, y: 0, autoMap: new Uint8Array(64 * 64).fill(1) }], buildings: () => [], discovered: () => [], player: () => ({ x: feet[0] / WORLD_PER_PX, y: feet[2] / WORLD_PER_PX, yaw: 0 }) });
+  const view = { ox: 0, oy: 0, scale: 1 };
+  assert.equal(sheet.destinationAt(10, 10), null, 'nothing is known before the sheet has been painted through a view');
+  sheet.paintOverlay(stub(), { view, paperW: 4000, paperH: 4000, dpr: 1, pulse: 0 });
+  const { toPaper } = await import('../src/ui/inkMap.js');
+  // the player on the paper: (feet.x / WORLD_PER_PX, sheetY(h, feet.z / WORLD_PER_PX)) with h = 128 and sheetY = (h - 1) - y
+  const px = feet[0] / WORLD_PER_PX, py = 127 - feet[2] / WORLD_PER_PX;
+  const [ax, ay] = toPaper(view, px + 10, py - 5);   // ten pixels east and five up the page: north
+  const d = sheet.destinationAt(ax, ay);
+  assert.ok(Math.abs(d.dx - 10 * WORLD_PER_PX) < 1e-6 && Math.abs(d.dz - 5 * WORLD_PER_PX) < 1e-6, 'east is +dx, up the page is +dz: ' + JSON.stringify(d));
+  assert.equal(sheet.destinationNear(ax, ay), false, 'no flag yet');
+  sheet.setDestination(d);
+  assert.equal(sheet.destinationNear(ax, ay - 6), true, 'the flag stands over its foot');
+  assert.equal(sheet.destinationNear(ax + 80, ay), false);
+  sheet.setDestination(null);
+  assert.equal(sheet.destinationNear(ax, ay), false);
+  const held = read('src/ui/heldMap.js');
+  assert.match(held, /if \(!this\._sheet\?\.context\(e\.clientX, e\.clientY\)\) this\._destinationContext\(e\.clientX, e\.clientY\);/, 'a right click the sheet does not take is a destination');
+  assert.match(held, /modBus\.emit\('mapPick', sheet\.id, d\.dx, d\.dz, !!d\.quest, !!d\.exit\)/);
+  assert.match(held, /modBus\.emit\('mapPick', sheet\.id, null, null, false\)/);
+  assert.match(read('src/ui/automapSheet.js'), /destinationAt\(px, py\) \{[\s\S]*planOfPaper\(px, py\)[\s\S]*dz: -\(z - ppz\)/, 'the dungeon plan reads its own paper-to-plan law');
+});
