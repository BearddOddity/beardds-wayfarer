+  assert.deepEqual(Object.keys(a).sort(), ['api', 'id', 'markColour', 'on', 'onKey', 'retarget', 'say', 'store', 't'], 'the handle is exactly these - no door to the net, the disk or another module');
+  assert.throws(() => { a.net = 1; }, TypeError, 'and frozen');
