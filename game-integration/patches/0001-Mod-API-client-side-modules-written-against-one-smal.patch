+    'Message:  1020', ' _agent_ awaits me in __agent_ in ___agent_.', '',
+    'Message:  1021', ' _agent_ awaits me in ___agent_.', '',
+    'Message:  1022', ' Ask for _agent_.', '',
+    'Message:  1023', ' _agent_ awaits me in __agent_, then go to ___keep_.', '',
+    'QBN:', 'Place _pub_ local tavern', 'Place _keep_ permanent Llugwych', 'Person _agent_ face 2 group Questor', '',
+    '--\tQuest start-up:', '\tplace npc _agent_ at _pub_', '', 'variable _pad_',
+  ], 0, { rolls: () => 0.3 }));
+  quiet(() => m.tick());
+  const agent = q.getPerson({ name: 'agent' });
+  assert.equal(entryTarget(q.getMessage(1020), { canFindPlace: () => false }), null, 'a questor is where the player already was: never where to go');
