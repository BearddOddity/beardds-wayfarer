+  assert.ok(read('src/mods/modBus.js').includes('text: (key, en, args) => formatMessage(tryGetLocalizedText(TextCollections.Port, key) ?? en, args, { locale: intlLocale() })'), 'the game\'s bus hands the game\'s own text core');
