new file mode 100644
index 0000000000..b21815b954
--- /dev/null
+++ b/src/mods/keysPanel.js
@@ -0,0 +1,182 @@
+// @ts-check
+// MODS1 (the player: "i want the hotkeys to be custom to the user"): THE MODULE KEYS PANEL - every action a module put on a
+// key, with the key it has now, and a way to give it another.
+//
+// Opened with Shift+F1 wherever the game is (no gameplay action of the game's is on it), or from Settings > Mods & files >
+// Modules. Choose an action (click it, or Tab to it and press Enter), then press the new key: Escape cancels, Backspace puts
+// the module's own key back. A key another module action has is refused with its name. A plain letter, digit, arrow or Space
+// is allowed with a warning, since the game may use it too. The choice is the bus's (createModBus setKey: kept in the game's
+// own storage) and takes effect at once.
+//
+// SMALL AND TO THE SIDE (the player: "way too big and in the way ... it shouldn't be center of the screen in case an enemy
+// appears"; "it should be left center"): docked at the left edge, halfway down, in small type, the middle of the view left clear. The
+// actions are grouped by module, and a name every module shares ("Beardd's Wayfarer: ...") is said once, not on every row.
+//
+// While the panel is open it takes every key press: the game and the modules hear none, and the pointer is released so the
+// panel can be clicked. Plain DOM and the words handed in (`words`), no game imports - so the loader's host (DFO Mods core) builds
+// the same panel for the released game.
+//
+// Not a DFU member. Ledger A (MODS1).
+
+import { keySpec } from './modApi.js';
+
+/** The key that opens the panel. Never a module's: the panel refuses it. */
+export const KEYS_PANEL_KEY = 'Shift+F1';
+/** Keys the panel itself and the game's menus use: never given to a module action. */
+const RESERVED = /^(Shift\+)?(Escape|Tab|Enter|Backspace|NumpadEnter)$/;
+/** Keys the game may well have on a plain press (movement, letters, numbers): allowed, with a warning. */
+const GAME_LIKELY = /^(Key[A-Z]|Digit\d|Arrow\w+|Space)$/;
+
+/** A key spec for people: 'Shift+KeyK' is 'Shift+K', 'Digit1' is '1'. Pure. @param {string|null} spec */
+export function keyName(spec) {
+  return spec ? spec.replace(/\b(Key|Digit)(?=\w$)/, '') : '';
+}
+
+/**
+ * The rows grouped by module, in order, with the part of the name every module shares said once: "Beardd's Wayfarer: pins" and
+ * "Beardd's Wayfarer: quest waypoint" are the family "Beardd's Wayfarer" and the groups "Pins", "Quest waypoint". Pure.
+ * @template {{ id: string, name: string }} R @param {R[]} rows
+ * @returns {{ family: string, groups: { name: string, rows: R[] }[] }}
+ */
+export function groupKeys(rows) {
+  const ids = [...new Set(rows.map((r) => r.id))];
+  const nameOf = (id) => rows.find((r) => r.id === id)?.name ?? id;
+  const heads = ids.map((id) => /^(.+?):\s+(.+)$/.exec(nameOf(id)));
+  const family = heads.length > 1 && heads.every((m) => m && m[1] === heads[0]?.[1]) ? heads[0][1] : '';
+  const short = (id, i) => { const n = family ? heads[i][2] : nameOf(id); return n.charAt(0).toUpperCase() + n.slice(1); };
+  return { family, groups: ids.map((id, i) => ({ name: short(id, i), rows: rows.filter((r) => r.id === id) })) };
+}
+
+/** @typedef {ReturnType<typeof import('./modApi.js').createModBus>} ModBus */
+/**
+ * THE PANEL'S WORDS, handed in by the host: the game's through its text core (modBus.js moduleKeyWords), the loader's in English.
+ * @typedef {{ title(): string, help(): string, done(): string, none(): string, press(): string, key(): string,
+ *   pressFor(what: string): string, reserved(key: string): string, taken(name: string, label: string): string, refused(): string,
+ *   gameKey(): string }} Words
+ */
+
+let open = null;
+
+/** Open the panel over the game (once; a second ask while it is open does nothing). @param {ModBus} bus @param {{ words: Words }} o */
+export function openKeysPanel(bus, { words }) {
+  const w = words;
+  if (open || typeof document === 'undefined' || !document.body) return;
+  document.exitPointerLock?.();
+  bus.holdKeys(true);
+
+  const box = document.createElement('div');
+  box.setAttribute('role', 'dialog');
+  box.setAttribute('aria-modal', 'true');
+  box.setAttribute('aria-label', w.title());
+  // docked at the left edge, halfway down: the middle of the view stays clear
+  box.style.cssText = 'position:fixed;left:12px;top:50%;transform:translateY(-50%);z-index:2147483001;width:300px;max-width:calc(100vw - 24px);'
+    + 'max-height:calc(100vh - 180px);overflow:auto;padding:8px 10px;font:13px/1.3 "Pixelify Sans",Georgia,serif;color:#f2e6c4;'
+    + 'background:rgba(10,12,17,0.86);border:1px solid #c9962c;box-shadow:0 0 10px #000';
+  const title = document.createElement('h2');
+  title.textContent = w.title();
+  title.style.cssText = 'margin:0 0 2px;font-size:15px;color:#c9962c';
+  const family = document.createElement('div');
+  family.style.cssText = 'margin:0 0 4px;font-size:12px;opacity:0.8';
+  const help = document.createElement('p');
+  help.textContent = w.help();
+  help.style.cssText = 'margin:0 0 6px;font-size:11px;opacity:0.8';
+  const list = document.createElement('div');
+  const status = document.createElement('p');
+  status.setAttribute('aria-live', 'polite');
+  status.style.cssText = 'min-height:1.3em;margin:6px 0;font-size:12px;color:#f2cf4a';
+  const done = document.createElement('button');
+  done.textContent = w.done();
+  box.append(title, family, help, list, status, done);
+
+  const buttonStyle = 'font:inherit;color:inherit;background:#1d2230;border:1px solid #c9962c;padding:1px 8px;cursor:pointer;min-width:72px';
+  done.style.cssText = buttonStyle;
+  /** @type {{ id: string, key: string, label: string } | null} */ let waiting = null;
+
+  function render(focusKey = null) {
+    list.replaceChildren();
+    const rows = bus.keys();
+    if (!rows.length) { list.textContent = w.none(); return; }
+    const g = groupKeys(rows);
+    family.textContent = g.family;
+    family.style.display = g.family ? '' : 'none';
+    for (const group of g.groups) {
+      const head = document.createElement('div');
+      head.textContent = group.name;
+      head.style.cssText = 'margin:6px 0 1px;font-size:12px;color:#c9962c';
+      list.append(head);
+      for (const r of group.rows) {
+        const row = document.createElement('div');
+        row.style.cssText = 'display:flex;justify-content:space-between;align-items:center;gap:8px;margin:2px 0 2px 6px';
+        const what = document.createElement('span');
+        what.textContent = r.label || r.key;
+        const said = `${group.name}: ${what.textContent}`;   // a screen reader and the status hear which module's action it is
+        const b = document.createElement('button');
+        b.style.cssText = buttonStyle;
+        const isWaiting = waiting?.id === r.id && waiting.key === r.key;
+        b.textContent = isWaiting ? w.press() : keyName(r.spec);
+        b.setAttribute('aria-label', `${said}. ${w.key()}: ${keyName(r.spec)}`);
+        b.onclick = () => { waiting = { id: r.id, key: r.key, label: r.label || r.key }; status.textContent = w.pressFor(said); render(`${r.id} ${r.key}`); };
+        row.append(what, b);
+        list.append(row);
+        if (focusKey === `${r.id} ${r.key}`) b.focus();
+      }
+    }
+  }
+
+  /** The new key for the action waiting on one. */
+  function choose(/** @type {any} */ e) {
+    const act = /** @type {{ id: string, key: string, label: string }} */ (waiting);
+    const back = `${act.id} ${act.key}`;
+    if (e.code === 'Escape') { waiting = null; status.textContent = ''; render(back); return; }
+    let r;
+    if (e.code === 'Backspace') r = bus.setKey(act.id, act.key, null);
+    else {
+      const spec = keySpec({ code: e.code, shiftKey: e.shiftKey, ctrlKey: e.ctrlKey, altKey: e.altKey, metaKey: e.metaKey });
+      if (!spec) return;   // a modifier alone, a repeat, Ctrl or Alt held: wait for a key
+      if (spec === KEYS_PANEL_KEY || RESERVED.test(spec)) { status.textContent = w.reserved(keyName(spec)); return; }
+      r = bus.setKey(act.id, act.key, spec);
+    }
+    const now = bus.keys().find((k) => k.id === act.id && k.key === act.key)?.spec ?? act.key;
+    if (!r.ok) status.textContent = r.reason === 'taken' && r.by ? w.taken(r.by.name, r.by.label) : w.refused();
+    else status.textContent = `${act.label}: ${keyName(now)}${GAME_LIKELY.test(now) ? ` - ${w.gameKey()}` : ''}`;
+    waiting = null;
+    render(back);
+  }
+
+  // every key press is the panel's while it is open: the game and the modules hear none of them (the browser's own Tab and
+  // Enter still move and press the panel's buttons)
+  const onKeyDown = (/** @type {KeyboardEvent} */ e) => {
+    e.stopImmediatePropagation();
+    if (waiting) { e.preventDefault(); if (!e.repeat) choose(e); return; }
+    if (e.code === 'Escape') { e.preventDefault(); close(); }
+  };
+  const onKeyUp = (/** @type {KeyboardEvent} */ e) => { e.stopImmediatePropagation(); };
+  const keepClicks = (/** @type {Event} */ e) => { e.stopPropagation(); };
+  function close() {
+    removeEventListener('keydown', onKeyDown, true);
+    removeEventListener('keyup', onKeyUp, true);
+    box.remove();
+    bus.holdKeys(false);
+    open = null;
+  }
+  addEventListener('keydown', onKeyDown, true);
+  addEventListener('keyup', onKeyUp, true);
+  for (const type of ['mousedown', 'mouseup', 'click', 'wheel']) box.addEventListener(type, keepClicks);
+  done.onclick = close;
+  document.body.append(box);
+  render();
+  (/** @type {HTMLElement|null} */ (list.querySelector('button')) ?? done).focus();
+  open = { close };
+}
+
+/**
+ * The host's side, once at start: every key press to the bus, and Shift+F1 opens the panel.
+ * @param {ModBus} bus @param {{ words: Words }} o
+ */
+export function installModuleKeys(bus, o) {
+  if (typeof addEventListener !== 'function') return;
+  addEventListener('keydown', (e) => {
+    if (keySpec(e) === KEYS_PANEL_KEY && !open && bus.keys().length) { e.preventDefault(); openKeysPanel(bus, o); return; }   // no module key, no panel
+    bus.pressKey(e);
+  }, true);
+}
diff --git a/src/mods/modApi.js b/src/mods/modApi.js
new file mode 100644
index 0000000000..b50c5ab3dd
--- /dev/null
+++ b/src/mods/modApi.js
@@ -0,0 +1,302 @@
+// @ts-check
+// MODS (2026-10-13, a player: the accessibility mod "needs to be a module like a rust crate type of mod ... unchained from
+// versioning ... it should work online"): THE MOD API - the small, stable surface a client-side module is written against.
+//
+// A MODULE IS A FOLDER, as a crate is: `module.json` (its manifest) and its code (`module.js`, one ES module whose default
+// export is `setup(dfo)`). The manifest names the module (`id`, `name`, its own `version`), the interface it was written for
+// (`api`, one whole number) and EVERY EVENT IT LISTENS TO (`events`) - that list is its whole contact with the game: the bus
+// hands it those events and no others, so a module's reach is read off its manifest.
+//
+// UNCHAINED FROM THE GAME'S VERSION. A module never names a game build. The interface is APPEND-ONLY: an event, once
+// shipped, keeps its name and its argument list forever, and a later version only ADDS events (and, at an event's end,
+// arguments); so a module written for api N runs on every game whose MOD_API_VERSION is N or more, untouched by the dozens
+// of releases a week. The game pins each event at its seam (test/mods1_api.test.js reads the source for the call), so the
+// hook cannot be dropped in a refactor without a test saying so.
+//
+// CLIENT-SIDE ONLY. A module is code the player installed, run in the player's own client: it reads what the game already
+// shows and draws on the player's own screen. The bus carries nothing to the server and changes no wire; a module has no
+// door to send a message to the relay, and a session online is exactly a session offline to everyone else in it.
+//
+// Not a DFU member. Ledger A (MODS1).
+
+/** The interface's version. A module's `api` is at most this; raised only when an event is ADDED, never when one changes. */
+export const MOD_API_VERSION = 1;
+
+/**
+ * THE EVENTS. Each: `since` (the api it arrived in), `args` (the argument list, in order - append-only), `doc`.
+ * @type {Readonly<Record<string, Readonly<{ since: number, args: ReadonlyArray<string>, doc: string }>>>}
+ */
+export const MOD_EVENTS = Object.freeze({
+  questMark: Object.freeze({
+    since: 1,
+    args: Object.freeze(['questXZ', 'playerXZ', 'heading01', 'markKind']),
+    doc: 'Every frame the HUD draws, in every scene: where the game\'s own compass marks the tracked quest ([x, z] in the scene\'s frame - [x, z, y] where the game knows the mark\'s height, as underground; null when it marks none), where the player stands ([x, z]) and which way they face (0..1 round the compass), and what the mark is (markKind: \'quest\', the kind a module named when it asked for the place with retarget - \'pin\', \'destination\', \'exit\', \'waypoint\' - or null when nothing is marked). The enhanced skin only.',
+  }),
+  quests: Object.freeze({
+    since: 1,
+    args: Object.freeze(['views']),
+    doc: 'After each quest tick: the game\'s own view of every active quest - { id, title, main, urgent, clockSeconds, words, latest: { lines }, target }.',
+  }),
+  mapPick: Object.freeze({
+    since: 1,
+    args: Object.freeze(['sheet', 'dxMetres', 'dzMetres', 'quest', 'exit', 'dyMetres']),
+    doc: 'A right click on the local map (the street plan or a dungeon\'s flat plan), or a pin the player drops and names on a dungeon\'s map (its middle click): where the place is from the player, in metres east (dx) and north (dz) in the scene\'s own axes - a quest\'s ringed building when quest is true, the dungeon\'s way out when exit is true (a click on its exit mark); dy how far the place stands above the player\'s feet, where the map knows it (a dungeon map\'s own pin, on any floor), else undefined. Both null: the player took their flag away.',
+  }),
+  drawFx: Object.freeze({
+    since: 1,
+    args: Object.freeze(['renderer', 'world']),
+    doc: 'Every frame the world pass draws its effects, under the renderer\'s own camera (renderer._camPos the eye, createParticleEffect / updateParticleEffect / drawWorldParticleEffects the door a module draws through), and `world`: a read-only probe of the solid world of the scene - floor(x, y, z) the floor height under (x, z) nearest below y (null when none), ray(origin, dir, max) the distance to the first wall (null when clear), and - where the host has them - doors(x, z, range) the doors of the street near (x, z) as [x, y, z], and known() what the player\'s map knows of the way about this place: { walked: the cells stood on, each "ix,y,iz" (1 m cells), steps: each one-way step taken (a teleporter, a drop) as [from x, y, z, to x, y, z] }, or null, and waypoints() the region map\'s waypoints the player follows, { id, name, x, z } each in this frame (asked afresh: the open world\'s frame moves as it streams), or null indoors and underground.',
+  }),
+});
+
+const SLUG = /^[a-z0-9][a-z0-9-]{0,63}$/;
+const DOTTED = /^\d+(\.\d+){0,3}$/;
+const ENTRY = /^[\w.-]+\.js$/;
+const FIELDS = new Set(['id', 'name', 'version', 'api', 'author', 'description', 'events', 'entry', 'sha256']);
+
+/**
+ * Read a module's manifest. Unknown fields are refused (a typo is not a silent default), the entry is a plain file name in the
+ * module's own folder, and the events are all ones this interface knows. Pure.
+ * @param {unknown} raw the parsed module.json
+ * @returns {{ ok: boolean, manifest: Manifest|null, errors: string[] }}
+ * @typedef {{ id: string, name: string, version: string, api: number, author: string, description: string, events: string[], entry: string, sha256: string|null }} Manifest
+ */
+export function parseManifest(raw) {
+  /** @type {string[]} */ const errors = [];
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return { ok: false, manifest: null, errors: ['the manifest is not an object'] };
+  const m = /** @type {Record<string, any>} */ (raw);
+  for (const k of Object.keys(m)) if (!FIELDS.has(k)) errors.push(`unknown field '${k}'`);
+  if (typeof m.id !== 'string' || !SLUG.test(m.id)) errors.push('id: a lowercase slug (a-z, 0-9, -), up to 64');
+  if (typeof m.name !== 'string' || !m.name.trim()) errors.push('name: required');
+  if (typeof m.version !== 'string' || !DOTTED.test(m.version)) errors.push('version: dotted numbers, 1 to 4 parts (1.2.0) - the module\'s own, never the game\'s');
+  if (!Number.isInteger(m.api) || m.api < 1) errors.push('api: the interface version it was written for, a whole number from 1');
+  if (!Array.isArray(m.events) || !m.events.length) errors.push('events: the events it listens to (a module with none can see nothing)');
+  else {
+    for (const e of m.events) if (typeof e !== 'string' || !Object.hasOwn(MOD_EVENTS, e)) errors.push(`events: '${e}' is not an event of this interface`);
+    if (new Set(m.events).size !== m.events.length) errors.push('events: listed twice');
+  }
+  if (m.entry !== undefined && (typeof m.entry !== 'string' || !ENTRY.test(m.entry))) errors.push('entry: a .js file in the module\'s own folder');
+  if (m.sha256 !== undefined && (typeof m.sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(m.sha256))) errors.push('sha256: 64 hex digits of the entry file');
+  for (const k of ['author', 'description']) if (m[k] !== undefined && typeof m[k] !== 'string') errors.push(`${k}: a string`);
+  if (errors.length) return { ok: false, manifest: null, errors };
+  return {
+    ok: true,
+    errors,
+    manifest: {
+      id: m.id, name: m.name.trim(), version: m.version, api: m.api, author: m.author ?? '', description: m.description ?? '',
+      events: [...m.events], entry: m.entry ?? 'module.js', sha256: m.sha256 ?? null,
+    },
+  };
+}
+
+/**
+ * Does this game run a module written for `manifest.api`? The interface only grows, so any module whose api the game has
+ * reached runs; every event it names must have arrived by the api it declares (a module cannot reach past its own api).
+ * @param {Manifest} manifest @param {number} [gameApi]
+ * @returns {{ ok: boolean, reason: string }}
+ */
+export function moduleCompatible(manifest, gameApi = MOD_API_VERSION) {
+  if (manifest.api > gameApi) return { ok: false, reason: `needs interface ${manifest.api}; this game has ${gameApi}` };
+  for (const e of manifest.events) if (MOD_EVENTS[e].since > manifest.api) return { ok: false, reason: `'${e}' arrived in interface ${MOD_EVENTS[e].since}, after the ${manifest.api} the module declares` };
+  return { ok: true, reason: '' };
+}
+
+/** A module's English with each `{name}` filled from `args` - for a host with no text core. Pure. @param {string} en @param {Record<string, unknown>|null} [args] */
+export const englishText = (en, args = null) => String(en).replace(/\{(\w+)\}/g, (m, k) => (args && Object.hasOwn(args, k) ? String(args[k]) : m));
+
+/** Failures one module may cause before the bus stops calling it for the session. */
+export const MOD_FAILURE_LIMIT = 25;
+
+/** Where the player's own keys for module actions are kept: { [module id]: { [the module's key]: the player's key } }. */
+export const MOD_KEYS_KEY = 'dfjs-module-keys';
+/** A key as a module names it and as the player's choice is kept: a KeyboardEvent code, Shift+ before it when held ('F7', 'Shift+KeyK'). */
+export const KEY_SPEC = /^(Shift\+)?[A-Za-z0-9]+$/;
+
+/**
+ * A key press as a spec, or null when it is not one a module may answer: a repeat, Ctrl, Alt or Meta held, a modifier alone, or
+ * typing in a text field. Pure. @param {any} e a keydown event
+ */
+export function keySpec(e) {
+  if (!e?.code || e.repeat || e.ctrlKey || e.altKey || e.metaKey || /^(Shift|Control|Alt|Meta|OS)(Left|Right)?$/.test(e.code)) return null;
+  const t = e.target;
+  if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return null;
+  return `${e.shiftKey ? 'Shift+' : ''}${e.code}`;
+}
+
+/**
+ * THE BUS. The game emits (`emit`), each registered module listens through its own handle (`register`). Nothing here knows any
+ * module by name: a module hears the events its manifest lists, and only while it is enabled; a listener that throws is
+ * isolated - the frame and every other module go on - and a module that fails MOD_FAILURE_LIMIT times is switched off.
+ *
+ * KEYS ARE THE PLAYER'S. A module names a default key for each action (`dfo.onKey`); the player may give any action another
+ * key (`setKey`, kept under MOD_KEYS_KEY), and the host hands every key press to `pressKey`, which answers it by the keys as
+ * they stand now - a change takes effect at once.
+ *
+ * WORDS IN THE PLAYER'S LANGUAGE (the player: "sync with DFO language so we don't need to create translation"): `text` is the
+ * game's own text core (systems/textManager.js t) - a module's `dfo.t(key, english, args)` reads the game's string table in the
+ * language the player chose, and the English it wrote where the table has no row yet. A module ships no translations: its
+ * words join the game's catalog and are translated with the game's own.
+ * @param {{ storage?: { getItem(k: string): string|null, setItem(k: string, v: string): void } | null,
+ *   say?: (text: string) => void, warn?: (...a: any[]) => void,
+ *   text?: ((key: string, en: string, args?: Record<string, unknown>|null) => string) | null }} [deps]
+ */
+export function createModBus({ storage = null, say = () => {}, warn = console.warn, text = null } = {}) {
+  /** @type {Map<string, Set<{ id: string, fn: (...a: any[]) => void }>>} */ const listeners = new Map();
+  /** @type {Map<string, { manifest: Manifest, enabled: boolean, failures: number, off: string|null }>} */ const mods = new Map();
+  /** @type {Map<string, { xz: number[], kind: string }>} the places modules ask the compass to point at instead (the last asked, by an enabled module, wins) */ const targets = new Map();
+  /** The place an enabled module asked for last, or null. */
+  const asked = () => { let at = null; for (const [id, t] of targets) if (mods.get(id)?.enabled) at = t; return at; };
+  /** @type {Map<string, string>} the colours modules ask the compass's mark to take (the last asked, by an enabled module, wins) */ const tints = new Map();
+  /** @type {{ id: string, key: string, label: string, fn: (e: any) => void }[]} every module action on a key, by its default key */ const actions = [];
+  let keysHeld = false;   // the keys panel is taking the presses
+  const ownKeys = () => { try { const v = JSON.parse(storage?.getItem(MOD_KEYS_KEY) || '{}'); return v && typeof v === 'object' ? v : {}; } catch { return {}; } };
+  const keyOf = (/** @type {{ id: string, key: string }} */ a, own = ownKeys()) => { const k = own[a.id]?.[a.key]; return typeof k === 'string' && KEY_SPEC.test(k) ? k : a.key; };
+  /** One module's code, run: a throw is counted against it, and the module is switched off at the limit. */
+  function run(/** @type {string} */ id, /** @type {string} */ what, /** @type {() => void} */ fn) {
+    const m = mods.get(id);
+    if (!m || !m.enabled) return;
+    try { fn(); } catch (e) {
+      if (++m.failures === 1) warn(`[module ${id}] a listener on '${what}' failed:`, e);   // an event's name, or a key's
+      if (m.failures >= MOD_FAILURE_LIMIT) { m.enabled = false; m.off = `failed ${MOD_FAILURE_LIMIT} times`; warn(`[module ${id}] switched off for the session`); }
+    }
+  }
+
+  return {
+    api: MOD_API_VERSION,
+
+    /** Is anything listening to `event` - the game's seams ask this first, so an event nobody wants costs a lookup. @param {string} event */
+    has: (event) => (listeners.get(event)?.size ?? 0) > 0,
+
+    /**
+     * The game's side, once a frame before the compass is drawn: the quest mark the compass shows - `quest` ([x, z] or null), or
+     * the place an enabled module asked for with `dfo.retarget`. Pure but for the table.
+     * @param {number[]|null} quest
+     */
+    retarget(quest) {
+      return asked()?.xz ?? quest;
+    },
+    /** The game's side, as the compass's mark is drawn: the colour an enabled module asked it to take with `dfo.markColour` ('#rrggbb'), or null for the game's own. */
+    markColour() {
+      let c = null;
+      for (const [id, t] of tints) if (mods.get(id)?.enabled) c = t;
+      return c;
+    },
+
+    /** The game's side: announce `event`. Each enabled listener on its own, a failing one counted. @param {string} event @param {...any} args */
+    emit(event, ...args) {
+      if (event === 'questMark') {   // every module sees the mark the compass shows, and what it is
+        const t = asked();
+        args[0] = t?.xz ?? args[0] ?? null;
+        args[3] = t ? t.kind : args[0] ? 'quest' : null;
+      }
+      const set = listeners.get(event);
+      if (!set) return;
+      for (const l of set) run(l.id, event, () => l.fn(...args));
+    },
+
+    /** The host's side: a keydown. Every enabled module action whose key (the player's, else its own) it is runs. Answers whether one did. @param {any} e */
+    pressKey(e) {
+      const spec = keysHeld ? null : keySpec(e);
+      if (!spec) return false;
+      const own = ownKeys();
+      const hit = actions.filter((a) => keyOf(a, own) === spec && mods.get(a.id)?.enabled);
+      for (const a of hit) run(a.id, spec, () => a.fn(e));
+      return hit.length > 0;
+    },
+    /** Every module action on a key: { id, name (the module's), label, key (its default), spec (the key it has now) }. */
+    keys() {
+      const own = ownKeys();
+      return actions.map((a) => ({ id: a.id, name: mods.get(a.id)?.manifest.name ?? a.id, label: a.label, key: a.key, spec: keyOf(a, own) }));
+    },
+    /**
+     * Give module `id`'s action on `key` (its default) the key `spec`, or its default back with null; kept. Refused, with the reason
+     * as a word the host puts in the player's language: 'unknown' (no such action), 'invalid' (not a key), 'taken' (another
+     * module action has it now - `by` says which) or 'unsaved' (the store would not keep it).
+     * @param {string} id @param {string} key @param {string|null} spec
+     * @returns {{ ok: boolean, reason: ''|'unknown'|'invalid'|'taken'|'unsaved', by?: { name: string, label: string } }}
+     */
+    setKey(id, key, spec) {
+      const a = actions.find((x) => x.id === id && x.key === key);
+      if (!a) return { ok: false, reason: 'unknown' };
+      const next = spec ?? key;
+      if (!KEY_SPEC.test(next)) return { ok: false, reason: 'invalid' };
+      const own = ownKeys();
+      const clash = actions.find((x) => x !== a && keyOf(x, own) === next);
+      if (clash) return { ok: false, reason: 'taken', by: { name: mods.get(clash.id)?.manifest.name ?? clash.id, label: clash.label || clash.key } };
+      const mine = { ...(own[id] ?? {}) };
+      if (next === key) delete mine[key]; else mine[key] = next;
+      if (Object.keys(mine).length) own[id] = mine; else delete own[id];
+      try { storage?.setItem(MOD_KEYS_KEY, JSON.stringify(own)); } catch { return { ok: false, reason: 'unsaved' }; }
+      return { ok: true, reason: '' };
+    },
+    /** The keys panel takes every press while it is open: no module key answers. @param {boolean} on */
+    holdKeys(on) { keysHeld = !!on; },
+
+    /**
+     * A module's side: its handle. `dfo.on(event, fn)` works only for an event the manifest lists (others are refused, once,
+     * with a warning); `dfo.store` is the module's own settings, apart from every other's; `dfo.say` a line over the game;
+     * `dfo.onKey('F7', fn, 'what it does')` an action on a key - F7 by default, the player's own key once they choose one; `dfo.retarget([x, z])` the place the compass marks, in place of the quest's; `dfo.markColour('#rrggbb')` the colour of the compass's mark; `dfo.t(key, english, args)` words in the player's language; `dfo.api` the interface version this game speaks.
+     * @param {Manifest} manifest
+     */
+    register(manifest) {
+      if (mods.has(manifest.id)) throw new Error(`module '${manifest.id}' is already registered`);
+      mods.set(manifest.id, { manifest, enabled: true, failures: 0, off: null });
+      const key = `dfjs-module-${manifest.id}`;
+      const read = () => { try { return JSON.parse(storage?.getItem(key) || '{}') || {}; } catch { return {}; } };
+      return Object.freeze({
+        api: MOD_API_VERSION,
+        id: manifest.id,
+        on(/** @type {string} */ event, /** @type {(...a: any[]) => void} */ fn) {
+          if (!manifest.events.includes(event)) { warn(`[module ${manifest.id}] '${event}' is not in its manifest's events - not delivered`); return () => {}; }
+          let set = listeners.get(event);
+          if (!set) listeners.set(event, set = new Set());
+          const l = { id: manifest.id, fn };
+          set.add(l);
+          return () => { set?.delete(l); };
+        },
+        store: Object.freeze({
+          get: (/** @type {string} */ k, /** @type {any} */ fallback) => { const v = read()[k]; return v === undefined ? fallback : v; },
+          set: (/** @type {string} */ k, /** @type {any} */ v) => { try { storage?.setItem(key, JSON.stringify({ ...read(), [k]: v })); } catch { /* not kept */ } },
+        }),
+        say: (/** @type {string} */ line) => { if (mods.get(manifest.id)?.enabled) say(String(line)); },
+        /** Words in the player's language: the game's string table's row for `key` (a dotted name, `module.<id>.<word>` for a
+         *  module's own), else `en`, with each `{name}` filled from `args`. */
+        t: (/** @type {string} */ key, /** @type {string} */ en, /** @type {Record<string, unknown>|null} */ args = null) => {
+          if (text) { try { return text(String(key), String(en), args); } catch { /* the English below */ } }
+          return englishText(en, args);
+        },
+        /** An action on a key: `spec` its default ('F7', 'Shift+F3'), `label` what it does (the keys panel's words). Answers a
+         *  function that says the key it has now - a module that names its key to the player asks it there. */
+        onKey: (/** @type {string} */ spec, /** @type {(e: any) => void} */ fn, /** @type {string} */ label = '') => {
+          if (typeof spec !== 'string' || !KEY_SPEC.test(spec) || typeof fn !== 'function') { warn(`[module ${manifest.id}] onKey`, spec); return () => null; }
+          const a = { id: manifest.id, key: spec, label: String(label), fn };
+          actions.push(a);
+          return () => keyOf(a);
+        },
+        /** Point the compass (and every module that follows the quest mark) at [x, z] in the scene's frame - [x, z, y] where the module
+         *  knows the place's floor, handed on as questMark's height - saying what it is (`kind`,
+         *  a lowercase word - 'pin', 'destination', 'exit', 'waypoint' - handed on as questMark's markKind; 'place' when unnamed); null gives it back to the game. */
+        retarget: (/** @type {number[]|null} */ xz, /** @type {string} */ kind = 'place') => {
+          targets.delete(manifest.id);
+          if (Array.isArray(xz) && Number.isFinite(xz[0]) && Number.isFinite(xz[1])) targets.set(manifest.id, { xz: Number.isFinite(xz[2]) ? [xz[0], xz[1], xz[2]] : [xz[0], xz[1]], kind: /^[a-z]{1,16}$/.test(String(kind)) ? String(kind) : 'place' });
+        },
+        /** Colour the compass's mark '#rrggbb' (the waypoint's diamond, so the two read as one); null (or anything else) gives it the game's own colour back. */
+        markColour: (/** @type {string|null} */ css) => {
+          tints.delete(manifest.id);
+          if (typeof css === 'string' && /^#[0-9a-f]{6}$/i.test(css)) tints.set(manifest.id, css.toLowerCase());
+        },
+      });
+    },
+
+    /** Switch a registered module on or off (its listeners stay; the bus skips them while it is off). @param {string} id @param {boolean} on */
+    setEnabled(id, on) {
+      const m = mods.get(id);
+      if (!m) return false;
+      m.enabled = !!on; m.off = on ? null : 'switched off';
+      if (on) m.failures = 0;
+      return true;
+    },
+    /** The modules the bus knows: { id, name, version, author, description, events, enabled, off, failures }. */
+    modules: () => [...mods.values()].map((m) => ({ id: m.manifest.id, name: m.manifest.name, version: m.manifest.version, author: m.manifest.author, description: m.manifest.description, events: m.manifest.events, enabled: m.enabled, off: m.off, failures: m.failures })),
+  };
+}
