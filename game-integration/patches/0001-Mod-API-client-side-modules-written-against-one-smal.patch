index 0000000000..6a557730a7
--- /dev/null
+++ b/app/lib/moduleFiles.cjs
@@ -0,0 +1,49 @@
+// MODS1 (src/mods/modApi.js): THE MODS FOLDER, as the shell reads it for the page.
+//
+// `<user data>/Mods/<id>/` is one module: a `module.json` and its entry (and whatever else the module ships). This reads two
+// things and nothing more - a module's raw manifest (the page's parseManifest is the one law that judges it) and its entry's
+// source text - and it reaches only inside the Mods folder: a module's folder name is a plain slug, its file a plain `.js`
+// name, and nothing that is not both is read. The page has no other door to the player's disk through this.
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+
+const SLUG = /^[a-z0-9][a-z0-9-]{0,63}$/;
+const FILE = /^[\w.-]+\.js$/;
+/** A manifest is a few hundred bytes; a module's entry a few hundred kilobytes at most. */
+const MANIFEST_MAX = 64 * 1024;
+const SOURCE_MAX = 4 * 1024 * 1024;
+
+/** @param {string} root the user data folder */
+function createModuleFiles(root) {
+  const dir = path.join(root, 'Mods');
+  const read = (file, max) => {
+    const st = fs.statSync(file);
+    if (!st.isFile() || st.size > max) return null;
+    return fs.readFileSync(file, 'utf8');
+  };
+  return {
+    dir,
+    /** Every folder under Mods that is named like a module: `{ dir, manifest }`, or `{ dir, error }` for one that cannot be read. */
+    list() {
+      let names = [];
+      try { names = fs.readdirSync(dir, { withFileTypes: true }).filter((d) => d.isDirectory() && SLUG.test(d.name)).map((d) => d.name).sort(); } catch { return []; }
+      return names.map((name) => {
+        try {
+          const text = read(path.join(dir, name, 'module.json'), MANIFEST_MAX);
+          if (text === null) return { dir: name, manifest: null, error: 'module.json is missing or too large' };
+          return { dir: name, manifest: JSON.parse(text) };
+        } catch (e) {
+          return { dir: name, manifest: null, error: `module.json: ${e && e.code === 'ENOENT' ? 'not found' : (e && e.message) || 'unreadable'}` };
+        }
+      });
+    },
+    /** A module's entry source, or null. */
+    source(name, file) {
+      if (typeof name !== 'string' || typeof file !== 'string' || !SLUG.test(name) || !FILE.test(file)) return null;
+      try { return read(path.join(dir, name, file), SOURCE_MAX); } catch { return null; }
+    },
+  };
+}
+
+module.exports = { createModuleFiles, SLUG, FILE };
