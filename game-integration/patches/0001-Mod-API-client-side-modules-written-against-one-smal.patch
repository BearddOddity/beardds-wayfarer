+test('MODS1: A MODULE\'S HANDLE - its own settings apart from every other\'s, its line and key only while it is on, nothing of the net', () => {
+  const mem = new Map();
+  const said = [];
+  const bus = createModBus({ storage: { getItem: (k) => mem.get(k) ?? null, setItem: (k, v) => mem.set(k, v) }, say: (t) => said.push(t) });
+  const a = bus.register(parseManifest({ ...good, id: 'a' }).manifest), b = bus.register(parseManifest({ ...good, id: 'b' }).manifest);
+  assert.equal(a.store.get('k', 'fallback'), 'fallback');
+  a.store.set('k', 3); a.store.set('j', [1]);
+  b.store.set('k', 9);
+  assert.deepEqual([a.store.get('k', 0), a.store.get('j', 0), b.store.get('k', 0), b.store.get('j', 'none')], [3, [1], 9, 'none']);
+  assert.ok(mem.has('dfjs-module-a') && mem.has('dfjs-module-b'), 'kept per module, in the game\'s own storage');
+  a.say('hello'); assert.deepEqual(said, ['hello']);
+  a.onKey('Shift+F7', () => said.push('pressed'));
+  a.onKey('F4', () => said.push('f4'));
+  assert.ok(!bus.pressKey({ code: 'F7' }), 'F7 alone is not Shift+F7');
+  assert.ok(bus.pressKey({ code: 'F7', shiftKey: true })); assert.deepEqual(said, ['hello', 'pressed']);
+  bus.setEnabled('a', false);
+  a.say('silenced'); bus.pressKey({ code: 'F7', shiftKey: true });
+  assert.deepEqual(said, ['hello', 'pressed'], 'a switched-off module neither speaks nor answers a key');
+  assert.deepEqual(Object.keys(a).sort(), ['api', 'id', 'markColour', 'on', 'onKey', 'retarget', 'say', 'store', 't'], 'the handle is exactly these - no door to the net, the disk or another module');
+  assert.throws(() => { a.net = 1; }, TypeError, 'and frozen');
+  const src = read('src/mods/modApi.js');
+  assert.ok(!/\bfetch\(|WebSocket|XMLHttpRequest|sendBeacon|net\//.test(src.replace(/\/\/[^\n]*/g, '')), 'modApi.js reaches nothing of the net');
+});
+
+test('MODS1: THE KEYS ARE THE PLAYER\'S - any module action takes another key at once, kept; a key another action has is refused; the panel holds them all', () => {
+  const mem = new Map(), heard = [];
+  const store = { getItem: (k) => mem.get(k) ?? null, setItem: (k, v) => mem.set(k, v) };
+  const bus = createModBus({ storage: store, warn() {} });
+  const a = bus.register(parseManifest({ ...good, id: 'a' }).manifest), b = bus.register(parseManifest({ ...good, id: 'b' }).manifest);
+  const keyA = a.onKey('F7', () => heard.push('a'), 'A on / off');
+  b.onKey('Shift+F2', () => heard.push('b'), 'B drops');
+  assert.equal(a.onKey('F7; drop', () => {})(), null, 'a spec that is not a key is not bound');
+  assert.deepEqual(bus.keys().map((k) => [k.id, k.label, k.key, k.spec]), [['a', 'A on / off', 'F7', 'F7'], ['b', 'B drops', 'Shift+F2', 'Shift+F2']]);
+  assert.deepEqual(bus.setKey('a', 'F7', 'KeyK'), { ok: true, reason: '' });
+  assert.equal(keyA(), 'KeyK', 'the module asks the key it has now');
+  assert.ok(!bus.pressKey({ code: 'F7' }) && bus.pressKey({ code: 'KeyK' }), 'the new key answers at once, the old one no longer');
+  assert.deepEqual(JSON.parse(mem.get(MOD_KEYS_KEY)), { a: { F7: 'KeyK' } }, 'kept in the game\'s own storage');
+  const again = createModBus({ storage: store, warn() {} }), a2 = again.register(parseManifest({ ...good, id: 'a' }).manifest);
+  a2.onKey('F7', () => heard.push('a2'));
+  assert.ok(again.pressKey({ code: 'KeyK' }) && heard.at(-1) === 'a2', 'and read again at the next start');
+  const clash = bus.setKey('a', 'F7', 'Shift+F2');
+  assert.deepEqual(clash, { ok: false, reason: 'taken', by: { name: 'Quest waypoint', label: 'B drops' } }, 'a key another module action has is refused, by name');
+  assert.deepEqual([bus.setKey('a', 'F7', 'Ctrl+K').reason, bus.setKey('a', 'nope', 'F9').reason], ['invalid', 'unknown'], 'not a key, or no such action');
+  assert.ok(!bus.pressKey({ code: 'KeyK', ctrlKey: true }) && !bus.pressKey({ code: 'KeyK', repeat: true }) && !bus.pressKey({ code: 'KeyK', target: { tagName: 'INPUT' } }), 'never with Ctrl, on a repeat or while typing');
+  bus.holdKeys(true);
+  assert.ok(!bus.pressKey({ code: 'KeyK' }), 'the keys panel holds every key while it is open');
+  bus.holdKeys(false);
+  assert.deepEqual(bus.setKey('a', 'F7', null), { ok: true, reason: '' });
+  assert.ok(bus.pressKey({ code: 'F7' }) && !mem.get(MOD_KEYS_KEY).includes('F7'), 'null puts the module\'s own key back');
+  b.onKey('F8', () => { throw new Error('boom'); });
+  for (let i = 0; i < MOD_FAILURE_LIMIT; i++) bus.pressKey({ code: 'F8' });
+  assert.equal(bus.modules().find((m) => m.id === 'b').enabled, false, 'a key handler that keeps throwing switches its module off');
+});
