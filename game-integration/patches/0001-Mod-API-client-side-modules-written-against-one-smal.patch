+// @ts-check
+// MODS1: THE GAME'S ONE BUS (src/mods/modApi.js) - made once, with the game's own storage, its own line over the HUD and the
+// page's keyboard. The game's seams import `modBus` and ask `modBus.has(event)` before they build an event's arguments, so an
+// event no module listens to costs a lookup; modules never import this - they are handed a handle (moduleHost.js).
+//
+// Not a DFU member. Ledger A (MODS1).
+
+import { appStorage } from '../systems/appStorage.js';   // the one storage seam
+import { hudText } from '../systems/notify.js';   // the line the game says things on
+import { t, tryGetLocalizedText, formatMessage, intlLocale, TextCollections } from '../systems/textManager.js';   // the keys panel's words, in the player's language
+import { createModBus } from './modApi.js';
+import { installModuleKeys } from './keysPanel.js';   // every key press to the bus; Shift+F1 the keys panel
+
+/** What startModules last reported (moduleHost.js): one row a module, for the Mods pane. */
+let lastReport = [];
+export const moduleReport = () => lastReport;
+export const setModuleReport = (/** @type {any[]} */ report) => { lastReport = report; };
+
+export const modBus = createModBus({
+  storage: { getItem: (k) => appStorage()?.getItem(k) ?? null, setItem: (k, v) => { appStorage()?.setItem(k, v); } },
+  say: (text) => { hudText(text); },
+  // a module's words in the player's language, from the game's own table (t's own read, for a key the module names at run time)
+  text: (key, en, args) => formatMessage(tryGetLocalizedText(TextCollections.Port, key) ?? en, args, { locale: intlLocale() }),
+});
+/** The keys panel's words (keysPanel.js KEYS_PANEL_ENGLISH), through the game's text core. */
+export const moduleKeyWords = Object.freeze({
+  title: () => t('menu.modules.keys.title', 'Module keys'),
+  help: () => t('menu.modules.keys.help', 'Choose an action, then press its new key. Escape cancels; Backspace puts its first key back.'),
+  done: () => t('menu.modules.keys.done', 'Done'),
+  none: () => t('menu.modules.keys.none', 'No module has a key.'),
+  press: () => t('menu.modules.keys.press', 'Press a key...'),
+  key: () => t('menu.modules.keys.key', 'Key'),
+  pressFor: (/** @type {string} */ what) => t('menu.modules.keys.pressFor', 'Press the new key for {what}.', { what }),
+  reserved: (/** @type {string} */ key) => t('menu.modules.keys.reserved', '{key} is kept for the menus. Choose another key.', { key }),
+  taken: (/** @type {string} */ name, /** @type {string} */ label) => t('menu.modules.keys.taken', 'Not changed: {name} has that key ({label}).', { name, label }),
+  refused: () => t('menu.modules.keys.refused', 'Not changed: that key could not be kept.'),
+  gameKey: () => t('menu.modules.keys.gameKey', 'the game may use this key too'),
+});
