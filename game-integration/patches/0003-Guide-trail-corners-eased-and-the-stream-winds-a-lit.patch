 var GUIDE_EMBER = Object.freeze([1, 0.55, 0.18]);
@@ -106,12 +107,13 @@ function createEmberField(max = GUIDE_MAX_EMBERS) {
         const A = path[seg - 1], B = path[seg];
         const u = segLen > 1e-6 ? (a - segStart) / segLen : 0;
         const dx = B[0] - A[0], dz = B[2] - A[2], dl = Math.hypot(dx, dz);
-        const sway = (h1 - 0.5) * 0.5 + Math.sin(t * 0.9 + h2 * TAU) * 0.08;
+        const snake = Math.sin(id * 0.33) * GUIDE_SNAKE_M;
+        const sway = (h1 - 0.5) * 0.5 + Math.sin(t * 0.9 + h2 * TAU) * 0.08 + snake;
         const phase = frac(t * 0.28 + h3);
         const pool = embers[n++];
-        pool.pos[0] = A[0] + dx * u;
+        pool.pos[0] = A[0] + dx * u + (dl > 1e-6 ? -dz / dl * snake : 0);
         pool.pos[1] = A[1] + (B[1] - A[1]) * u + GUIDE_POOL_LIFT_M;
-        pool.pos[2] = A[2] + dz * u;
+        pool.pos[2] = A[2] + dz * u + (dl > 1e-6 ? dx / dl * snake : 0);
         pool.alpha = Math.min(1, env * GUIDE_POOL_ALPHA * brightness * (0.8 + 0.2 * Math.sin(t * 2 + h2 * TAU)));
         pool.size = GUIDE_POOL_M;
         pool.color[0] = 1;
@@ -412,9 +414,25 @@ function createRouter(world, { now = () => performance.now() } = {}) {
         i = j;
       }
       if (goalNode) pulled.push([gx, pulled[pulled.length - 1][1], gz]);
-      const pts = [pulled[0]];
-      for (let k = 1; k < pulled.length; k++) {
-        const a = pts[pts.length - 1], b = pulled[k];
+      let round = pulled;
+      for (let pass = 0; pass < 2 && round.length > 2; pass++) {
+        const next = [round[0]];
+        for (let k = 1; k < round.length - 1; k++) {
+          const p = round[k - 1], q = round[k], r = round[k + 1];
+          const back = (o) => {
+            const t = Math.min(0.34, 4 / Math.max(1e-6, Math.hypot(o[0] - q[0], o[2] - q[2])));
+            return [q[0] + (o[0] - q[0]) * t, q[1] + (o[1] - q[1]) * t, q[2] + (o[2] - q[2]) * t];
+          };
+          const a = back(p), b = back(r);
+          if (sees(a, b)) next.push(a, b);
+          else next.push(q);
+        }
+        next.push(round[round.length - 1]);
+        round = next;
+      }
+      const pts = [round[0]];
+      for (let k = 1; k < round.length; k++) {
+        const a = pts[pts.length - 1], b = round[k];
         const len = Math.hypot(b[0] - a[0], b[2] - a[2]), steps = Math.max(1, Math.round(len / CELL));
         let y = a[1];
         for (let s = 1; s <= steps; s++) {
@@ -472,7 +490,7 @@ function setup(dfo) {
     }
     if (!plan || now - plan.at > REPLAN_MS || Math.hypot(plan.goal[0] - mark.q[0], plan.goal[1] - mark.q[1]) > 3) {
       const got = router.plan(feet, mark.q);
-      plan = { at: now, goal: mark.q, pts: got ? smoothPath(got.pts, 1) : null };
+      plan = { at: now, goal: mark.q, pts: got ? smoothPath(got.pts, 2) : null };
     }
     return plan.pts;
   }
diff --git a/modules/guide-trail/src/embers.js b/modules/guide-trail/src/embers.js
index ef48beac8b..a13731d046 100644
--- a/modules/guide-trail/src/embers.js
+++ b/modules/guide-trail/src/embers.js
@@ -22,6 +22,8 @@ export const GUIDE_SIZE_M = Object.freeze([0.1, 0.2]);
 /** THE FLOOR'S GLOW: under every spark a soft pool of the ember's orange lying on the floor, so the stream reads as one warm path\n *  from the far end of the window, and not as a few sparks a dark floor swallows - its half-extent (m), its lift off the floor (m)\n *  and its strongest alpha. */
 export const GUIDE_POOL_M = 0.3;
 export const GUIDE_POOL_LIFT_M = 0.1;
+/** How far the stream winds to either side of the path (m). */
+export const GUIDE_SNAKE_M = 0.35;
 export const GUIDE_POOL_ALPHA = 0.5;
 /** The two golds an ember is drawn between: the quest diamond's own light, and an ember's deeper orange. */
 export const GUIDE_GOLD = Object.freeze([1, 0.82, 0.38]);
@@ -145,10 +147,11 @@ export function createEmberField(max = GUIDE_MAX_EMBERS) {
         const A = path[seg - 1], B = path[seg];
         const u = segLen > 1e-6 ? (a - segStart) / segLen : 0;
         const dx = B[0] - A[0], dz = B[2] - A[2], dl = Math.hypot(dx, dz);
-        const sway = ((h1 - 0.5) * 0.5 + Math.sin(t * 0.9 + h2 * TAU) * 0.08);
+        const snake = Math.sin(id * 0.33) * GUIDE_SNAKE_M;   // the whole stream winds a little, the bend riding with its embers
+        const sway = ((h1 - 0.5) * 0.5 + Math.sin(t * 0.9 + h2 * TAU) * 0.08) + snake;
         const phase = frac(t * 0.28 + h3);
         const pool = embers[n++];   // the floor's glow under this slot's spark: on the path itself, a slow shimmer
-        pool.pos[0] = A[0] + dx * u; pool.pos[1] = A[1] + (B[1] - A[1]) * u + GUIDE_POOL_LIFT_M; pool.pos[2] = A[2] + dz * u;
+        pool.pos[0] = A[0] + dx * u + (dl > 1e-6 ? -dz / dl * snake : 0); pool.pos[1] = A[1] + (B[1] - A[1]) * u + GUIDE_POOL_LIFT_M; pool.pos[2] = A[2] + dz * u + (dl > 1e-6 ? dx / dl * snake : 0);
         pool.alpha = Math.min(1, env * GUIDE_POOL_ALPHA * brightness * (0.8 + 0.2 * Math.sin(t * 2 + h2 * TAU)));
         pool.size = GUIDE_POOL_M;
         pool.color[0] = 1; pool.color[1] = 0.6; pool.color[2] = 0.12;   // a deep amber: the pool is a translucent stain, and amber still reads on snow where a pale gold would not
diff --git a/modules/guide-trail/src/route.js b/modules/guide-trail/src/route.js
index 8b8e8bdf0a..4e739ba2ec 100644
--- a/modules/guide-trail/src/route.js
+++ b/modules/guide-trail/src/route.js
@@ -127,10 +127,24 @@ export function createRouter(world, { now = () => performance.now() } = {}) {
         pulled.push(raw[j]); i = j;
       }
       if (goalNode) pulled.push([gx, pulled[pulled.length - 1][1], gz]);
+      // round the corners: each cut back along its two legs (a third, at most 4 m) and joined, twice - a cut kept only where its
+      // line is still in sight, so a turn is a curve and never a corner through a wall
+      let round = pulled;
+      for (let pass = 0; pass < 2 && round.length > 2; pass++) {
+        const next = [round[0]];
+        for (let k = 1; k < round.length - 1; k++) {
+          const p = round[k - 1], q = round[k], r = round[k + 1];
+          const back = (o) => { const t = Math.min(0.34, 4 / Math.max(1e-6, Math.hypot(o[0] - q[0], o[2] - q[2]))); return [q[0] + (o[0] - q[0]) * t, q[1] + (o[1] - q[1]) * t, q[2] + (o[2] - q[2]) * t]; };
+          const a = back(p), b = back(r);
+          if (sees(a, b)) next.push(a, b); else next.push(q);
+        }
+        next.push(round[round.length - 1]);
+        round = next;
+      }
       // a point a metre on every straight stretch, lying on the floor
-      const pts = [pulled[0]];
-      for (let k = 1; k < pulled.length; k++) {
-        const a = pts[pts.length - 1], b = pulled[k];
+      const pts = [round[0]];
+      for (let k = 1; k < round.length; k++) {
+        const a = pts[pts.length - 1], b = round[k];
         const len = Math.hypot(b[0] - a[0], b[2] - a[2]), steps = Math.max(1, Math.round(len / CELL));
         let y = a[1];
         for (let s = 1; s <= steps; s++) {
diff --git a/modules/guide-trail/src/setup.js b/modules/guide-trail/src/setup.js
