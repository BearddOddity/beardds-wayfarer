-// MODULE: QUEST TRACKER PANEL.
-//
-// A small panel on the left listing every active quest: where to go, the time left, and the opening of the latest journal
-// entry. Main quests carry a star; a deadline under a day is red. Hears `quests` (the game's own quest views) and, only to
-// know when the HUD is on screen, `questMark`; reaches nothing else.
-//
-// Key: Shift+F7 on / off. Setting: this module's own store (`maxQuests`, default 6).
-const GOLD = '#c9962c';
-const HUD_STALE_MS = 300;
-
-/** Game seconds left, in the journal's own coarse words. */
-export function timeLeft(s) {
-  if (!Number.isFinite(s)) return '';
-  const days = Math.floor(s / 86400), hours = Math.floor((s % 86400) / 3600);
-  if (days >= 1) return `${days}d ${hours}h left`;
-  if (hours >= 1) return `${hours}h left`;
-  return 'under an hour left';
-}
-
-// A log entry opens with its date ("Sundas the 1st of Morning Star:"); the panel wants the words after it.
-const DATE_LINE = /^\s*\S+ the \d{1,2}(st|nd|rd|th) of .+?:?\s*$/;
-export function opening(lines, max = 110) {
-  const text = (lines ?? []).filter((l) => !DATE_LINE.test(l)).join(' ').replace(/\s+/g, ' ').trim();
-  if (text.length <= max) return text;
-  const cut = text.lastIndexOf(' ', max);
-  return `${text.slice(0, cut > 40 ? cut : max)}…`;
-}
-
-export default function setup(dfo) {
-  let on = dfo.store.get('on', true);
-  const maxQuests = () => dfo.store.get('maxQuests', 6);
-
-  let quests = [];
-  let hudSeen = -1e9;
-  dfo.on('quests', (list) => { quests = Array.isArray(list) ? list : []; });
-  dfo.on('questMark', () => { hudSeen = performance.now(); });   // only the HUD's heartbeat: hide the panel with the HUD
-
-  let el = null, drawn = '';
-  function build() {
-    const css = document.createElement('style');
-    css.textContent = `
-      #dfo-tracker { position: fixed; left: 16px; top: 28%; width: 300px; padding: 8px 10px; pointer-events: none; z-index: 2147483000;
-        font: 14px/1.25 "Pixelify Sans", Georgia, serif; color: #f2e6c4; text-shadow: 0 0 3px #000, 0 1px 2px #000;
-        background: rgba(10, 12, 17, 0.55); border-left: 3px solid ${GOLD}; }
-      #dfo-tracker .q { margin: 0 0 8px; }
-      #dfo-tracker .q:last-child { margin-bottom: 0; }
-      #dfo-tracker .t { color: ${GOLD}; font-weight: bold; }
-      #dfo-tracker .main .t::before { content: "\\2605 "; }
-      #dfo-tracker .w { color: #d8cfae; font-size: 13px; }
-      #dfo-tracker .o { color: #cfc6a8; font-size: 12px; opacity: 0.9; }
-      #dfo-tracker .urgent { color: #ff8a6a; }`;
-    document.head.append(css);
-    el = document.createElement('div');
-    el.id = 'dfo-tracker';
-    document.body.append(el);
-  }
-
-  function draw() {
-    const live = performance.now() - hudSeen < HUD_STALE_MS;
-    if (!live || !on || !quests.length) { el.style.display = 'none'; return; }
-    el.style.display = '';
-    const rows = quests.slice(0, maxQuests()).map((q) => ({
-      title: q.title || q.name || 'Quest', main: !!q.main, where: typeof q.words === 'string' ? q.words : (q.words?.where || ''), urgent: !!q.urgent,
